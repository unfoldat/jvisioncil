---
// 2026-08-17 디자인 목업 반영 — 홈의 "최근 소식"(간단 목록)과 소식 목록/태그 페이지(카드 그리드)가
// 이 한 컴포넌트에서 갈린다. 실제 소식에는 사진·요약 필드가 없어 목업의 사진 자리는 넣지 않는다.
import type { CollectionEntry } from 'astro:content';
import { noticeHref, noticeOrgDisplay } from '../lib/notices';
import { orgMap } from '../lib/networkOrgs';

interface Props {
  notices: CollectionEntry<'notices'>[];
  variant?: 'home' | 'board';
  empty: string;
}
const { notices, variant = 'board', empty } = Astro.props;
const iso = (d: Date) => d.toISOString().slice(0, 10);
const orgs = await orgMap();
const items = notices.map((notice) => {
  const org = noticeOrgDisplay(notice, orgs);
  return {
    ...noticeHref(notice),
    title: notice.data.title,
    orgName: org.name,
    orgUrl: org.url,
    date: notice.data.date,
    pinned: notice.data.pinned,
  };
});
---

{items.length === 0 ? (
  <p class="notice-empty">{empty}</p>
) : variant === 'home' ? (
  <ul class="notice-list-home">
    {items.map((item) => (
      <li>
        <div class="notice-line">
          {item.pinned && <span class="pinned-label"><span aria-hidden="true">📌</span> 상단 고정</span>}
          {item.orgUrl ? (
            <a class="tag" href={item.orgUrl} target="_blank" rel="noopener noreferrer">{item.orgName}<span class="sr-only">, 공식 사이트, 새 창에서 열림</span></a>
          ) : (
            <span class="tag">{item.orgName}</span>
          )}
          {item.external ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer">{item.title}<span class="sr-only">, 원문, 새 창에서 열림</span></a>
          ) : (
            <a href={item.href}>{item.title}</a>
          )}
        </div>
        <time datetime={iso(item.date)} class="notice-date">{iso(item.date)}</time>
      </li>
    ))}
  </ul>
) : (
  <ul class="notice-board">
    {items.map((item) => (
      <li class="notice-card">
        <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
          <span class="notice-card-body">
            <time datetime={iso(item.date)} class="notice-card-date">{iso(item.date)}</time>
            {item.pinned && <span class="pinned-label"><span aria-hidden="true">📌</span> 상단 고정</span>}
            {item.orgUrl ? (
              <span class="tag">{item.orgName}</span>
            ) : (
              <span class="tag">{item.orgName}</span>
            )}
            <h3>{item.title}{item.external && <span class="sr-only">, 원문, 새 창에서 열림</span>}</h3>
            {item.external && <span class="external-link-label" aria-hidden="true">원문 · 새 창</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .notice-empty { font: 400 1.13em/1.75 Pretendard, system-ui, sans-serif; color: var(--muted); }
  .pinned-label, .external-link-label, .tag {
    display: inline-block; border-radius: 999px; font: 700 0.84em/1.4 Pretendard, system-ui, sans-serif; padding: 3px 10px;
  }
  .pinned-label { background: #f9eedd; color: #664c27; }
  .external-link-label { background: #eeeaf4; color: #5f5571; }
  .tag { background: #f3eed9; color: #5c5640; text-decoration: none; }
  a.tag:hover { background: #ece2c4; }

  .notice-list-home { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); background: #fff; }
  .notice-list-home li { border-bottom: 1px solid var(--line); padding: 0.85rem 0.4rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .notice-line { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .notice-line a { font: 700 1.06em/1.4 Pretendard, system-ui, sans-serif; }
  .notice-date { color: var(--muted); font-size: 0.92em; white-space: nowrap; }

  .notice-board { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .notice-card { border: 1px solid #d0c3d2; border-radius: 16px; background: #f6f4f6; overflow: hidden; }
  .notice-card a { display: block; text-decoration: none; color: inherit; }
  .notice-card a:hover { background: #efe9ef; }
  .notice-card-body { display: block; padding: 24px 24px 28px; }
  .notice-card-date { display: block; font: 700 0.94em/1 Pretendard, system-ui, sans-serif; color: #554458; margin-bottom: 10px; }
  .notice-card .tag { margin-bottom: 10px; }
  .notice-card h3 { margin: 10px 0 0; font: 800 1.38em/1.5 NanumSquareRound, Pretendard, sans-serif; color: #403342; text-wrap: pretty; }

  @media (max-width: 860px) { .notice-board { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .notice-board { grid-template-columns: 1fr; } .notice-list-home li { flex-direction: column; align-items: flex-start; } }
</style>
