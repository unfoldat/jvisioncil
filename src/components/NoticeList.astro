---
// 2026-08-17 디자인 목업 반영 — 소식 목록/태그 페이지의 카드 그리드.
// 2026-08-18 대표 사진(image) 필드 추가 — 비어있으면 로고를 기본 이미지로 표시.
import type { CollectionEntry } from 'astro:content';
import { noticeHref } from '../lib/notices';

interface Props {
  notices: CollectionEntry<'notices'>[];
  empty: string;
  currentPage?: number;
  totalPages?: number;
}
const { notices, empty, currentPage = 1, totalPages = 1 } = Astro.props;
const pageHref = (n: number) => (n === 1 ? '/소식/' : `/소식/페이지/${n}/`);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const items = notices.map((notice) => ({
  ...noticeHref(notice),
  title: notice.data.title,
  date: notice.data.date,
  pinned: notice.data.pinned,
  image: notice.data.image,
  imageAlt: notice.data.imageAlt,
  summary: notice.data.summary,
}));
---

{items.length === 0 ? (
  <p class="notice-empty">{empty}</p>
) : (
  <ul class="notice-board">
    {items.map((item) => (
      <li class="notice-card">
        <a href={item.href}>
          <span class="notice-card-photo">
            {item.image
              ? <img class="notice-card-photo-img" src={item.image} alt={item.imageAlt ?? ''} loading="lazy" />
              : <img class="notice-card-photo-fallback" src="/images/logo-mark.png" alt="" loading="lazy" />}
          </span>
          <span class="notice-card-body">
            <time datetime={iso(item.date)} class="notice-card-date">{iso(item.date)}</time>{' '}
            {item.pinned && <span class="pinned-label"><span aria-hidden="true">📌</span> 상단 고정</span>}{' '}
            <h3>{item.title}</h3>
            {item.summary && <span class="notice-card-summary">{item.summary}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
)}

{totalPages > 1 && (
  <nav aria-label="소식 목록 쪽 이동" class="notice-pagination">
    {pages.map((n) => (
      <a href={pageHref(n)} aria-current={n === currentPage ? 'page' : undefined}>{n}</a>
    ))}
  </nav>
)}

<style>
  .notice-empty { font: 400 1.13em/1.75 Pretendard, system-ui, sans-serif; color: var(--muted); }
  .pinned-label {
    display: inline-block; border-radius: 999px; font: 700 0.84em/1.4 Pretendard, system-ui, sans-serif; padding: 3px 10px;
    background: #f9eedd; color: #664c27;
  }

  .notice-board { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .notice-card { border: 1px solid #d0c3d2; border-radius: 16px; background: #f6f4f6; overflow: hidden; }
  .notice-card-photo { display: flex; align-items: center; justify-content: center; height: 12.5em; border-bottom: 1px solid #d0c3d2; background: #fff; }
  .notice-card-photo-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .notice-card-photo-fallback { height: 22%; width: auto; object-fit: contain; display: block; }
  .notice-card a { display: block; text-decoration: none; color: inherit; }
  .notice-card a:hover { background: #efe9ef; }
  .notice-card-body { display: block; padding: 24px 24px 28px; }
  .notice-card-date { display: block; font: 700 0.94em/1 Pretendard, system-ui, sans-serif; color: #554458; margin-bottom: 10px; }
  .notice-card h3 { margin: 10px 0 0; font: 800 1.38em/1.5 NanumSquareRound, Pretendard, sans-serif; color: #403342; text-wrap: pretty; }
  .notice-card-summary { display: block; margin: 10px 0 0; font: 400 1.06em/1.75 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); text-wrap: pretty; }

  .notice-pagination { display: flex; gap: 10px; justify-content: center; margin: 42px 0 0; }
  .notice-pagination a {
    display: inline-flex; align-items: center; justify-content: center; min-width: 2.8em; padding: 12px 14px;
    border-radius: 10px; text-decoration: none; font: 700 1.13em/1 NanumSquareRound, Pretendard, sans-serif;
    background: #fff; color: #554458; border: 1.5px solid #d0c3d2;
  }
  .notice-pagination a[aria-current='page'] {
    font-weight: 800; background: #403342; color: #fff; border-color: #403342;
  }

  @media (max-width: 860px) { .notice-board { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .notice-board { grid-template-columns: minmax(0, 1fr); } }
</style>
