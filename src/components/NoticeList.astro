---
// 2026-08-17 디자인 목업 반영 — 소식 목록/태그 페이지의 카드 그리드.
// 2026-08-19 작업지시서(오후) — 카드 썸네일은 편집자가 직접 넣는 thumbnail 필드를
// 쓴다(본문 첫 이미지 자동 재사용은 카드·본문 중복 문제로 폐지). 없으면 로고 폴백.
// 2026-08-19 접근성 감사 — 썸네일이 정보성 사진이면 alt=""로 고정하면 안 되므로
// thumbnailAlt를 그대로 alt에 쓴다. 편집자가 안 채웠으면 alt=""(장식용) — 카드가
// 이미 h3 제목으로 글을 식별하므로 이 경우엔 빈 alt가 정보 손실이 아니다.
// 2026-08-20(목업 DOM 매핑 결과 반영) — 카드 aria-labelledby 재조합(제목→"소식
// 상세보기"→작성일)을 폐지했다. design-mockup.jvisioncil.pages.dev/plan3#/news
// 실기 라이브 DOM을 직접 확인한 결과, 카드 <a>에는 커스텀 ARIA가 전혀 없고
// Tab 이름은 순수 DOM 순서(사진 aria-hidden 제외→작성일→제목→요약)로만 계산되는
// 구조였다 — 이게 실제로 잘 작동한 패턴이었다. "소식 상세보기" 같은 sr-only 문구도
// 목업엔 없다(실제 a href만으로 링크 role이 네이티브로 전달됨). 원하는 낭독 문장을
// ARIA로 조립하지 않고, semantic HTML과 DOM 순서에 그대로 맡긴다.
// 2026-08-20(카드 전체 <a> → <h3><a> 구조 전환) — 위 변경 후 실제 SenseReader
// 실기에서 카드 전체를 감싸던 <a> 안에 <h3>가 중첩된 구조 때문에, Tab 낭독이
// 제목을 건너뛰는 문제가 확인됐다(docs/accessibility-decision-log.md 참고).
// DOM·accname 스펙·Chrome accessibility tree는 전부 제목을 포함시키는데
// SenseReader의 Tab(focus mode)만 빠뜨렸다 — 화살표 모드는 정상 인식. 원인을
// ARIA로 덮지 않고 구조로 해결: 이제 실제 Tab 정지점(=실제 <a>)은 <h3> 안의
// 제목 링크 하나뿐이다. 카드 전체 클릭 UX는 CSS stretched-link(.notice-card-link
// ::after)로 시각적으로만 복원 — 새 JS/role/tabindex 없음.
import type { CollectionEntry } from 'astro:content';
import { noticeHref } from '../lib/notices';

interface Props {
  notices: CollectionEntry<'notices'>[];
  empty: string;
  currentPage?: number;
  totalPages?: number;
  // 2026-08-25 홈 "최근 소식" 미리보기용 — 사진 영역(aspect-ratio 3/2·object-fit
  // cover, 실기로 검증된 부분)은 그대로 두고 본문 타이포·패딩만 줄여서 카드 전체
  // 크기를 홈의 다른 카드(주요 서비스)와 비슷하게 맞춘다. 요약문은 공간을 많이
  // 차지해 미리보기에서는 생략(시각·스크린리더 둘 다 — 보충 정보라 생략해도
  // 본문 파악에 지장 없음).
  compact?: boolean;
}
const { notices, empty, currentPage = 1, totalPages = 1, compact = false } = Astro.props;
const pageHref = (n: number) => (n === 1 ? '/소식/' : `/소식/페이지/${n}/`);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const items = notices.map((notice) => ({
  ...noticeHref(notice),
  title: notice.data.title,
  date: notice.data.date,
  pinned: notice.data.pinned,
  thumbnail: notice.data.thumbnail,
  thumbnailAlt: notice.data.thumbnailAlt,
  summary: notice.data.summary,
}));
---

{items.length === 0 ? (
  <p class="notice-empty">{empty}</p>
) : (
  <ul class:list={['notice-board', { compact }]}>
    {items.map((item, i) => (
      <li class="notice-card">
        <article>
          <span class="notice-card-photo">
            {item.thumbnail
              ? <img class="notice-card-photo-img" src={item.thumbnail} alt={item.thumbnailAlt ?? ''} loading="lazy" />
              : <img class="notice-card-photo-fallback" src="/images/logo-mark.png" alt="" loading="lazy" />}
          </span>
          <span class="notice-card-body">
            <span class="notice-card-meta">
              <time datetime={iso(item.date)} class="notice-card-date"><span class="sr-only">작성일 </span>{iso(item.date)}</time>
              {item.pinned && <span class="pinned-label"><span aria-hidden="true">📌</span> 고정됨</span>}
            </span>
            <h3><a class="notice-card-link" href={item.href}>{item.title}</a></h3>
            {!compact && item.summary && <p class="notice-card-summary">{item.summary}</p>}
          </span>
        </article>
      </li>
    ))}
  </ul>
)}

{totalPages > 1 && (
  <nav aria-label="소식 목록 쪽 이동" class="notice-pagination">
    {pages.map((n) => (
      <a href={pageHref(n)} aria-current={n === currentPage ? 'page' : undefined}>{n}</a>
    ))}
  </nav>
)}

<style>
  .notice-empty { font: 400 1.13em/1.75 Pretendard, system-ui, sans-serif; color: var(--muted); }
  .pinned-label {
    display: inline-block; border-radius: 999px; font: 700 0.72em/1.3 Pretendard, system-ui, sans-serif; padding: 0 8px;
    background: #f9eedd; color: #664c27;
  }

  .notice-board { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .notice-card { position: relative; border: 1px solid #d0c3d2; border-radius: 16px; background: #f6f4f6; overflow: hidden; }
  /* 2026-08-19 작업지시서 — 카드 썸네일은 "식별용"이라 크롭 허용, 고정 3:2 프레임으로
     통일(세로 포스터가 와도 이 프레임 안에서는 가운데 기준으로 잘려 보임). */
  .notice-card-photo { display: flex; align-items: center; justify-content: center; aspect-ratio: 3 / 2; border-bottom: 1px solid #d0c3d2; background: #fff; }
  .notice-card-photo-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .notice-card-photo-fallback { height: 22%; width: auto; object-fit: contain; display: block; }
  .notice-card-body { display: block; padding: 24px 24px 28px; }
  .notice-card-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .notice-card-date { display: block; font: 700 0.94em/1 Pretendard, system-ui, sans-serif; color: #554458; }
  .notice-card h3 { margin: 10px 0 0; font: 800 1.38em/1.5 NanumSquareRound, Pretendard, sans-serif; color: #403342; text-wrap: pretty; }
  /* 2026-08-20 — 카드 전체 클릭 UX를 CSS만으로 복원(stretched-link). 실제 Tab
     정지점/accessible name은 이 <a>(제목) 하나뿐 — ::after가 카드 전체를 덮어
     마우스/터치로는 어디를 눌러도 이 링크가 눌린다. */
  .notice-card-link { text-decoration: none; color: inherit; }
  .notice-card-link::after { content: ''; position: absolute; inset: 0; }
  .notice-card:hover { background: #efe9ef; }
  /* ::after가 카드 전체를 덮어 시각 포커스 링이 제목 글자에만 좁게 그려지므로,
     제목 링크가 포커스일 때 카드 테두리 전체에도 같은 포커스 스타일을 겹쳐 그려
     "카드 전체가 선택됐다"는 걸 알 수 있게 한다(BaseLayout 전역 :focus-visible과
     같은 색/굵기 재사용 — 새 색상 추가 없음). */
  .notice-card:has(.notice-card-link:focus-visible) { outline: 3px solid #1a1512; outline-offset: 2px; }
  .notice-card-summary {
    display: -webkit-box; margin: 10px 0 0; font: 400 1.06em/1.75 NanumSquareRound, Pretendard, sans-serif;
    color: var(--muted); text-wrap: pretty; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  .notice-pagination { display: flex; gap: 10px; justify-content: center; margin: 42px 0 0; }
  .notice-pagination a {
    display: inline-flex; align-items: center; justify-content: center; min-width: 2.8em; padding: 12px 14px;
    border-radius: 10px; text-decoration: none; font: 700 1.13em/1 NanumSquareRound, Pretendard, sans-serif;
    background: #fff; color: #554458; border: 1.5px solid #d0c3d2;
  }
  .notice-pagination a[aria-current='page'] {
    font-weight: 800; background: #403342; color: #fff; border-color: #403342;
  }

  @media (max-width: 860px) { .notice-board { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .notice-board { grid-template-columns: minmax(0, 1fr); } }

  /* 2026-08-25 compact(홈 미리보기) — 사진 영역(.notice-card-photo·-img, aspect-ratio
     3/2 + object-fit:cover)은 실기로 검증된 부분이라 손대지 않는다. 본문 패딩·
     제목 크기만 줄여 카드 전체 높이를 낮춘다. */
  /* 2026-08-26 — 홈 "주요 서비스"(card-grid-4)와 같은 톤: 한 줄에 4개. 기본
     .notice-board(3열, /소식/ 전용)와는 다른 값이라 .compact에서만 덮어쓴다. */
  .notice-board.compact { gap: 18px; grid-template-columns: repeat(4, 1fr); }
  /* 사진 매커니즘(aspect-ratio + object-fit:cover)은 그대로 재사용 — 비율 숫자만
     3:2→15:8로 낮춰 카드 전체 높이를 "주요 서비스" 카드(254.5px)에 맞춘다(한 줄
     4개 기준 — 열이 늘면서 카드 폭이 좁아져 5:2보다 조금 더 낮은 비율이 필요했다). */
  .notice-board.compact .notice-card-photo { aspect-ratio: 15 / 8; }
  .notice-board.compact .notice-card-body { padding: 14px 18px 18px; }
  .notice-board.compact .notice-card-meta { margin-bottom: 6px; }
  .notice-board.compact .notice-card-date { font-size: 0.88em; }
  .notice-board.compact .notice-card h3 { margin-top: 6px; font: 800 1.13em/1.35 NanumSquareRound, Pretendard, sans-serif; }
  /* 홈 페이지의 .card-grid-4(주요 서비스)와 같은 반응형 단계를 맞춘다. */
  @media (max-width: 860px) { .notice-board.compact { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .notice-board.compact { grid-template-columns: minmax(0, 1fr); } }
</style>
