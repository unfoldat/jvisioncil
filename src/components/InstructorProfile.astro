---
// 2026-08-23 — 강사 프로필 PDF 원본 구조로 전면 교체. 강의/index.astro·강의/종류/페이지/
// [page].astro·강의/기타/페이지/[page].astro 세 페이지가 전부 같은 "강사 프로필" 구역을
// 렌더링하는데(이미 그 셋 사이에서 카드 CSS가 조용히 갈라져 있었음 — 실측으로 발견),
// 이번 프로필은 훨씬 복잡해져서(표·정의목록) 세 번 복제하면 그 문제가 더 커진다
// — LectureGrid/ExtraCourseGrid와 같은 이유로 컴포넌트 하나로 뺀다.
//
// 헤딩 구조: 페이지의 H2(강사 프로필) 다음, 각 강사가 H3(이름) → H4(강사 소개/학력 사항/
// 주요 활동 및 강연 실적/보유 자격 사항). 필드가 비어 있으면(교체 강사가 정보를 덜 채운
// 경우) 해당 구역 전체를 생략 — 빈 표/빈 목록을 만들지 않는다.
//
// 2026-08-26 — bio(약력 소개) 렌더링 복원. CMS 폼에는 intro/education/career/
// certifications 필드가 아예 없다(김기현만 수작업으로 채운 특수 케이스) — CMS로
// 만드는 강사는 전부 bio(단순 문자열 목록)만 쓴다. 이름/직함 바로 아래, 소제목 없이
// 단순 목록으로만 표시(예전 심플 레이아웃과 동일) — 아래 구간(강사 소개/학력 사항 등,
// h4+구분선 있는 .tutor-section들)과는 시각적으로 다른, 더 가벼운 처리다.
import type { CollectionEntry } from 'astro:content';

interface Props {
  instructors: CollectionEntry<'instructors'>[];
}
const { instructors } = Astro.props;
---

{instructors.length === 0 ? (
  <p class="lead-sm">아직 등록된 강사 프로필이 없습니다.</p>
) : (
  <div class="tutor-list">
    {instructors.map((t, i) => {
      const nameId = `tutor-name-${i}`;
      const introId = `tutor-intro-${i}`;
      const eduId = `tutor-edu-${i}`;
      const careerId = `tutor-career-${i}`;
      const certId = `tutor-cert-${i}`;
      const hasMeta = Boolean(t.data.region || t.data.availableDays);
      return (
        <article class="tutor-profile" aria-labelledby={nameId}>
          <header class="tutor-identity">
            <img
              class="tutor-photo"
              src={t.data.photo}
              alt={t.data.photoAlt ?? ''}
              style={`object-position:${t.data.photoPos || 'center 20%'}`}
            />
            <div class="tutor-identity-text">
              <h3 id={nameId}>{t.data.name}</h3>
              <p class="tutor-affiliation">{t.data.role}</p>
              {hasMeta && (
                <dl class="tutor-meta">
                  {t.data.region && (
                    <div class="tutor-meta-row">
                      <dt>활동지역</dt>
                      <dd>{t.data.region}</dd>
                    </div>
                  )}
                  {t.data.availableDays && (
                    <div class="tutor-meta-row">
                      <dt>활동요일</dt>
                      <dd>{t.data.availableDays}</dd>
                    </div>
                  )}
                </dl>
              )}
              {t.data.bio && t.data.bio.length > 0 && (
                <ul class="tutor-bio-list">
                  {t.data.bio.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </div>
          </header>

          {t.data.intro && t.data.intro.length > 0 && (
            <section aria-labelledby={introId} class="tutor-section">
              <h4 id={introId}>강사 소개</h4>
              <p class="tutor-intro">
                {t.data.intro.map((para, i) => <>{i > 0 && <br />}{para}</>)}
              </p>
            </section>
          )}

          {t.data.education && t.data.education.length > 0 && (
            <section aria-labelledby={eduId} class="tutor-section">
              <h4 id={eduId}>학력 사항</h4>
              <div class="tutor-table-wrap">
                <table>
                  <caption class="sr-only">{t.data.name} 학력 사항</caption>
                  <thead>
                    <tr>
                      <th scope="col">학위 및 과정</th>
                      <th scope="col">학교 및 전공</th>
                    </tr>
                  </thead>
                  <tbody>
                    {t.data.education.map((e) => (
                      <tr>
                        <th scope="row">{e.degree}</th>
                        <td>{e.school}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}

          {t.data.career && t.data.career.length > 0 && (
            <section aria-labelledby={careerId} class="tutor-section">
              <h4 id={careerId}>주요 활동 및 강연 실적</h4>
              <ul class="tutor-career-list">
                {t.data.career.map((c) => {
                  // "(2017~현재)"처럼 연도 범위가 붙은 라벨(강의 실적/전문 교육/자문 활동/
                  // 공공 강사)만 라벨 다음 줄바꿈 — 기관 직책/대학 출강/방송 및 저서처럼
                  // 연도 범위가 없는 항목은 기존대로 한 줄에 이어 쓴다.
                  const breakAfterLabel = /\(\d{4}~현재\)$/.test(c.label);
                  return (
                    <li>
                      <strong>{c.label}:</strong>{breakAfterLabel ? <br /> : ' '}
                      {c.detail.split('\n').map((line, i) => (
                        <>{i > 0 && <br />}{line}</>
                      ))}
                    </li>
                  );
                })}
              </ul>
            </section>
          )}

          {t.data.certifications && t.data.certifications.length > 0 && (
            <section aria-labelledby={certId} class="tutor-section">
              <h4 id={certId}>보유 자격 사항</h4>
              <ul class="tutor-tag-list">
                {t.data.certifications.map((cert) => <li>{cert}</li>)}
              </ul>
            </section>
          )}
        </article>
      );
    })}
  </div>
)}

<style>
  .tutor-list { display: grid; gap: 28px; }
  .tutor-profile { border: 1px solid #e5bfbf; border-radius: 16px; background: #faf2f2; padding: 28px 30px 32px; }

  .tutor-identity { display: grid; grid-template-columns: minmax(140px, 170px) minmax(0, 1fr); gap: clamp(16px, 3vw, 24px); align-items: start; }
  .tutor-photo { width: 100%; max-width: 170px; aspect-ratio: 3/4; object-fit: cover; border-radius: 12px; display: block; }
  .tutor-identity-text { min-width: 0; }
  .tutor-identity-text h3 { margin: 0 0 6px; font: 800 1.62em/1.3 Pretendard, system-ui, sans-serif; color: #5a3737; }
  .tutor-affiliation { margin: 0 0 16px; font: 700 1.06em/1.5 Pretendard, system-ui, sans-serif; color: #784949; }

  /* 활동지역/활동요일 — 반복 없는 라벨-값 1세트라 dl(표 아님). 행마다 div로 감싸 라벨이
     줄바꿈돼도 값과 붙어 보이게 한다(dt/dd를 바로 flex로 두면 좁은 화면에서 라벨만 먼저
     한 줄, 값이 다음 줄로 떨어져 관계가 흐려짐). */
  .tutor-meta { margin: 0; display: grid; gap: 6px; }
  .tutor-meta-row { display: flex; gap: 10px; font: 400 1em/1.6 Pretendard, system-ui, sans-serif; }
  .tutor-meta-row dt { flex: none; width: 5em; font-weight: 700; color: #5a3737; }
  .tutor-meta-row dd { margin: 0; color: var(--muted); }

  /* 2026-08-26 — bio 심플 목록. 아래 .tutor-career-list와 같은 점 불릿 언어를
     재사용하되, 소제목·구분선 없이 이름/직함 바로 아래 가볍게 붙는다. */
  .tutor-bio-list { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 6px; }
  .tutor-bio-list li {
    position: relative; padding-left: 1.3em; font: 400 1.02em/1.6 Pretendard, system-ui, sans-serif; color: var(--muted); text-wrap: pretty;
  }
  .tutor-bio-list li::before { content: ''; position: absolute; left: 0.1em; top: 0.65em; width: 5px; height: 5px; border-radius: 50%; background: #c87a7a; }

  .tutor-section { margin-top: 26px; padding-top: 22px; border-top: 1px solid #e5bfbf; }
  /* PDF 원본의 "제목 왼쪽 세로 바 강조"를 페이지 배색(#c87a7a)으로 재현. */
  .tutor-section h4 {
    margin: 0 0 16px; padding-left: 12px; border-left: 4px solid #c87a7a;
    font: 800 1.19em/1.4 Pretendard, system-ui, sans-serif; color: #5a3737;
  }
  .tutor-intro { margin: 0; padding: 18px 20px; border-radius: 10px; background: #fff; border: 1px solid #e5bfbf;
    font: 400 1.06em/1.8 Pretendard, system-ui, sans-serif; color: var(--muted); text-wrap: pretty; }

  /* 학력 사항 — 다른 소제목과 동일한 section+h4 구조(접기 없음). H 탐색이 이미
     "관심 없으면 건너뛰기"를 제공하므로 별도 접기 상호작용은 불필요하다고 판단. */
  .tutor-table-wrap { overflow-x: auto; }
  .tutor-section table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 10px; overflow: hidden; }
  .tutor-section th, .tutor-section td {
    padding: 12px 16px; text-align: left; font: 400 0.98em/1.5 Pretendard, system-ui, sans-serif; color: var(--muted);
    border-bottom: 1px solid #e5bfbf;
  }
  .tutor-section thead th { background: #f4d9dc; color: #5a3737; font-weight: 700; }
  .tutor-section tbody th { font-weight: 700; color: #5a3737; white-space: nowrap; }
  .tutor-section tr:last-child th, .tutor-section tr:last-child td { border-bottom: none; }

  .tutor-career-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .tutor-career-list li {
    position: relative; padding-left: 1.3em; font: 400 1.02em/1.7 Pretendard, system-ui, sans-serif; color: var(--muted); text-wrap: pretty;
  }
  .tutor-career-list li::before { content: ''; position: absolute; left: 0.1em; top: 0.7em; width: 5px; height: 5px; border-radius: 50%; background: #c87a7a; }
  .tutor-career-list strong { color: #5a3737; }

  /* 보유 자격 사항 — 알약형 태그(기존 pinned-label/pill과 같은 시각 언어). */
  .tutor-tag-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tutor-tag-list li {
    padding: 8px 16px; border-radius: 999px; background: #f4d9dc; color: #5a3737;
    font: 700 0.94em/1.3 Pretendard, system-ui, sans-serif;
  }

  @media (max-width: 640px) {
    .tutor-identity { grid-template-columns: minmax(0, 1fr); }
    .tutor-photo { max-width: 160px; margin: 0 auto; }
  }
</style>
