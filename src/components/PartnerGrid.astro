---
// 협력기관 배너 그리드 (2026-08-17 디자인 목업 반영) — 기관소개/홈 본문에 배치.
// 배지 클릭 = 기관 홈페이지로 같은 창에서 이동(새 창 아님 — 뒤로가기로 돌아올 수 있어야
// 스크린리더 사용자가 탐색을 잃지 않는다는 것을 목업 스크린리더 테스트에서 확인했다).
// url 없으면 링크 없이 텍스트만. network-orgs는 실제 협력기관만 담는다.
import { partnerOrgs } from '../lib/networkOrgs';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const orgs = await partnerOrgs();
---

<ul class:list={['partner-banners', { compact }]}>
  {orgs.map((org) => (
    <li>
      {org.data.url ? (
        <a class="partner-banner" href={org.data.url}>{org.data.name}</a>
      ) : (
        <span class="partner-banner">{org.data.name}<small>공식 주소 확인 중</small></span>
      )}
    </li>
  ))}
</ul>

<style>
  .partner-banners {
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    align-items: stretch;
    display: grid;
  }
  .partner-banners li { display: flex; }
  .partner-banner {
    flex: 1;
    min-height: 4.8em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 14px 16px;
    border: 1px solid #96876a;
    border-radius: 10px;
    background: #fff;
    text-decoration: none;
    color: var(--muted);
    font: 700 0.97em/1.45 NanumSquareRound, Pretendard, sans-serif;
    text-wrap: pretty;
  }
  .partner-banner:hover {
    background: #f3eed9;
  }
  .partner-banner small {
    color: var(--muted);
    font-weight: 400;
    display: block;
  }
  @media (width <= 950px) {
    .partner-banners {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width <= 640px) {
    .partner-banners {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
