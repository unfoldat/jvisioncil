---
// 2026-08-19 CMS 컬렉션 전환(작업지시서) — 강의.astro(강의 안내)와 종류/페이지/[page].astro가
// 공유하는 "강의 종류" 카드 그리드(NoticeList.astro와 동일한 이유로 분리: 두 라우트가
// 같은 카드 마크업을 각자 복제하면 나중에 하나만 고치고 잊어버리는 사고가 난다).
import type { CollectionEntry } from 'astro:content';

interface Props {
  lectures: CollectionEntry<'lectures'>[];
  currentPage?: number;
  totalPages?: number;
}
const { lectures, currentPage = 1, totalPages = 1 } = Astro.props;
const pageHref = (n: number) => (n === 1 ? '/강의/' : `/강의/종류/페이지/${n}/`);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<ul class="lecture-grid">
  {lectures.map((l, i) => {
    const titleId = `lecture-${i}-title`;
    return (
      <li class="lecture-card">
        <article aria-labelledby={titleId}>
          <h3 id={titleId}>{l.data.title}</h3>
          <p class="lecture-desc">{l.data.desc}</p>
          <div class="lecture-meta-group">
            {l.data.mandatory && (
              <span class="lecture-badge">
                <svg class="lecture-badge-icon" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14">
                  <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M12.516 2.17a.75.75 0 0 0-1.032 0 11.209 11.209 0 0 1-7.877 3.08.75.75 0 0 0-.722.515A12.74 12.74 0 0 0 2.25 9.75c0 5.942 4.064 10.933 9.563 12.348a.75.75 0 0 0 .374 0c5.499-1.415 9.563-6.406 9.563-12.348 0-1.39-.223-2.73-.635-3.985a.75.75 0 0 0-.722-.516l-.143.001c-2.996 0-5.717-1.17-7.734-3.08Zm3.094 8.016a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z"></path>
                </svg>
                법정의무교육
              </span>
            )}
            <p class="lecture-meta">
              <span class="lecture-meta-item"><strong>대상</strong> {l.data.target}</span>
              <span class="sep" aria-hidden="true">|</span>
              <span class="lecture-meta-item"><strong>시간</strong> {l.data.meta}</span>
            </p>
          </div>
        </article>
      </li>
    );
  })}
</ul>

{totalPages > 1 && (
  <nav aria-label="강의 종류 쪽 이동" class="lecture-pagination">
    {pages.map((n) => (
      <a href={pageHref(n)} aria-current={n === currentPage ? 'page' : undefined}>{n}</a>
    ))}
  </nav>
)}

<style>
  .lecture-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  /* 카드 상자 스타일은 li가 아니라 article에 건다 — li는 목록 항목일 뿐이고, article이
     accessible name(aria-labelledby)을 가진 실제 카드 단위다. li는 grid item으로 늘어난
     높이를 article에 그대로 넘겨야 하므로 height:100%. */
  .lecture-card > article { height: 100%; padding: 28px 26px; border: 1px solid #e5bfbf; border-radius: 16px; background: #faf2f2; display: flex; flex-direction: column; }
  .lecture-card h3 { margin: 0 0 10px; font: 800 1.44em/1.4 Pretendard, system-ui, sans-serif; color: #5a3737; text-wrap: pretty; }
  .lecture-desc { margin: 0 0 14px; font: 400 1.06em/1.75 Pretendard, system-ui, sans-serif; color: var(--muted); text-wrap: pretty; }
  /* 배지·대상·시간은 전부 "카드를 요약하는 메타정보"라는 같은 범주라 하나의 그룹으로
     묶는다(게슈탈트 근접성) — 설명문과는 margin-top:auto로 여백을 두어 분리하고,
     그룹 내부(배지↔대상/시간)는 gap을 좁게 유지해 한 덩어리로 보이게 한다. */
  .lecture-meta-group { margin-top: auto; display: flex; flex-direction: column; gap: 8px; }
  /* 시안 B — 진한 로즈 배경 + 흰 글씨(대비 12.1:1, WCAG AAA도 통과). 방패 이모지가
     플랫폼마다 모양이 애매하게 렌더링돼(사용자 지적) SVG로 교체 — 참고 이미지의 세
     방패 스타일 중 세 번째(Heroicons shield-check 실루엣)로 최종 선택. 체크마크는
     별도 색 지정 없이 fill-rule="evenodd"로 방패 안을 "구멍" 내는 방식이라 배지
     배경색이 자동으로 비쳐 보인다(하드코딩된 색 없음 — 배지 배경이 바뀌어도 안 깨짐).
     장식용이라 aria-hidden, 실제 낭독은 "법정의무교육" 텍스트만. 알약(pill) 모양은
     둥근 왼쪽 끝이 카드의 다른 요소(h3/설명/대상)와 공유하는 세로 정렬선에서 혼자
     벗어나 보여 네모(둥근 사각형)로 변경 — 왼쪽 padding만큼 당기는 보정 없이도
     사각형 박스의 왼쪽 모서리가 자연스럽게 그 정렬선에 맞는다. */
  .lecture-badge {
    display: inline-flex; align-items: center; gap: 5px; width: fit-content; border-radius: 6px;
    font: 700 0.84em/1.4 Pretendard, system-ui, sans-serif; padding: 4px 10px; background: #7a3b41; color: #fff;
  }
  .lecture-badge-icon { flex-shrink: 0; }
  /* 대상/시간 — 배지처럼 배경 없는 담백한 텍스트, 값(<strong> 아님)과 라벨(<strong>)이
     같은 굵기 계열로 보이게 하되(동급), 라벨-값 관계는 마크업(strong)으로 코드에 남긴다
     (SC 1.3.1). 라벨 색은 카드 배경(#faf2f2) 대비 4.5:1 미달(#a97878→3.72:1)이라 이
     페이지에서 이미 쓰는 #784949(대비 6.69:1)로 교체 — 실측치는 커밋 메시지에 기록.
     대상/시간을 한 줄 텍스트로 이어 쓰면 화살표 탐색에서 "대상 ... | 시간 ..."이
     통째로 한 번에 읽힌다(실기 확인) — display:flex로 두 항목을 별도 박스(flex item)로
     분리하면 시각적으로는 같은 줄이지만 각각 독립된 탐색 단위가 된다(일반 inline
     흐름과 달리 flex 자식은 접근성 트리 선형화에서 줄 경계로 취급됨). */
  .lecture-meta { margin: 0; display: flex; align-items: baseline; font: 400 0.94em/1.5 Pretendard, system-ui, sans-serif; color: var(--muted); }
  .lecture-meta strong { font-weight: 700; color: #784949; }
  .lecture-meta .sep { margin: 0 0.6em; color: #e5bfbf; }

  .lecture-pagination { display: flex; gap: 10px; justify-content: center; margin: 32px 0 0; }
  .lecture-pagination a {
    display: inline-flex; align-items: center; justify-content: center; min-width: 2.8em; padding: 12px 14px;
    border-radius: 10px; text-decoration: none; font: 700 1.13em/1 Pretendard, system-ui, sans-serif;
    background: #fff; color: #784949; border: 1.5px solid #e5bfbf;
  }
  .lecture-pagination a[aria-current='page'] {
    font-weight: 800; background: #5a3737; color: #fff; border-color: #5a3737;
  }

  @media (max-width: 860px) { .lecture-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .lecture-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
