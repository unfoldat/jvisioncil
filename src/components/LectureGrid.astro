---
// 2026-08-19 CMS 컬렉션 전환(작업지시서) — 강의.astro(강의 안내)와 종류/페이지/[page].astro가
// 공유하는 "강의 종류" 카드 그리드(NoticeList.astro와 동일한 이유로 분리: 두 라우트가
// 같은 카드 마크업을 각자 복제하면 나중에 하나만 고치고 잊어버리는 사고가 난다).
import type { CollectionEntry } from 'astro:content';

interface Props {
  lectures: CollectionEntry<'lectures'>[];
  currentPage?: number;
  totalPages?: number;
}
const { lectures, currentPage = 1, totalPages = 1 } = Astro.props;
const pageHref = (n: number) => (n === 1 ? '/강의/' : `/강의/종류/페이지/${n}/`);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<ul class="lecture-grid">
  {lectures.map((l, i) => {
    const titleId = `lecture-${i}-title`;
    return (
      <li class="lecture-card">
        <article aria-labelledby={titleId}>
          <h3 id={titleId}>{l.data.title}</h3>
          <p class="lecture-desc">{l.data.desc}</p>
          <span class:list={['lecture-badge', { 'lecture-badge-hidden': !l.data.mandatory }]} aria-hidden={l.data.mandatory ? undefined : 'true'}>
            <span class="lecture-badge-icon" aria-hidden="true">🛡</span>
            법정의무교육
          </span>
          <p class="lecture-meta">
            <strong>대상</strong> {l.data.target}
            <span class="sep" aria-hidden="true">|</span>
            <strong>시간</strong> {l.data.meta}
          </p>
        </article>
      </li>
    );
  })}
</ul>

{totalPages > 1 && (
  <nav aria-label="강의 종류 쪽 이동" class="lecture-pagination">
    {pages.map((n) => (
      <a href={pageHref(n)} aria-current={n === currentPage ? 'page' : undefined}>{n}</a>
    ))}
  </nav>
)}

<style>
  .lecture-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  /* 카드 상자 스타일은 li가 아니라 article에 건다 — li는 목록 항목일 뿐이고, article이
     accessible name(aria-labelledby)을 가진 실제 카드 단위다. li는 grid item으로 늘어난
     높이를 article에 그대로 넘겨야 하므로 height:100%. */
  .lecture-card > article { height: 100%; padding: 28px 26px; border: 1px solid #e5bfbf; border-radius: 16px; background: #faf2f2; display: flex; flex-direction: column; }
  .lecture-card h3 { margin: 0 0 10px; font: 800 1.44em/1.4 Pretendard, system-ui, sans-serif; color: #5a3737; text-wrap: pretty; }
  .lecture-desc { margin: 0 0 14px; font: 400 1.06em/1.75 Pretendard, system-ui, sans-serif; color: var(--muted); text-wrap: pretty; }
  /* 시안 B — 진한 로즈 배경 + 흰 글씨 pill(대비 12.1:1, WCAG AAA도 통과). 방패 이모지는
     장식용이라 aria-hidden, 실제 낭독은 "법정의무교육" 텍스트만. */
  .lecture-badge {
    display: inline-flex; align-items: center; gap: 5px; width: fit-content; border-radius: 999px;
    font: 700 0.84em/1.4 Pretendard, system-ui, sans-serif; padding: 4px 12px; background: #7a3b41; color: #fff; margin-bottom: 14px;
  }
  .lecture-badge-icon { font-size: 0.95em; }
  .lecture-badge-hidden { visibility: hidden; }
  /* 대상/시간 — 배지처럼 배경 없는 담백한 텍스트, 값(<strong> 아님)과 라벨(<strong>)이
     같은 굵기 계열로 보이게 하되(동급), 라벨-값 관계는 마크업(strong)으로 코드에 남긴다
     (SC 1.3.1). 라벨 색은 흰 배경 대비 4.5:1 미달(#a97878→3.72:1)이라 이 페이지에서
     이미 쓰는 #784949(대비 7.37:1)로 교체 — 실측: base/판정-보안기준.md 아님, 여기 코드
     주석에 직접 기록. */
  .lecture-meta { display: block; margin-top: auto; font: 400 0.94em/1.5 Pretendard, system-ui, sans-serif; color: var(--muted); }
  .lecture-meta strong { font-weight: 700; color: #784949; }
  .lecture-meta .sep { margin: 0 0.6em; color: #e5bfbf; }

  .lecture-pagination { display: flex; gap: 10px; justify-content: center; margin: 32px 0 0; }
  .lecture-pagination a {
    display: inline-flex; align-items: center; justify-content: center; min-width: 2.8em; padding: 12px 14px;
    border-radius: 10px; text-decoration: none; font: 700 1.13em/1 Pretendard, system-ui, sans-serif;
    background: #fff; color: #784949; border: 1.5px solid #e5bfbf;
  }
  .lecture-pagination a[aria-current='page'] {
    font-weight: 800; background: #5a3737; color: #fff; border-color: #5a3737;
  }

  @media (max-width: 860px) { .lecture-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .lecture-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
