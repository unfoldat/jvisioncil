---
// 2026-08-17 디자인 목업(design-mockup, 시안4) 포팅 — 목업 index.html의 헤더·nav·푸터·
// 접근성 기능(포커스 이중 링·읽기 커서·고대비·글자 크기 4단계)을 그대로 이식한다.
import { getEntry } from 'astro:content';
import { SITE_NAME, SITE_DESCRIPTION, ORG_FULL_NAME, MAIN_MENU, FOOTER_MENU, NOINDEX } from '../config';
import { telHref } from '../lib/orgInfo';

// 확정 스키마 결정 — 주소·대표전화는 파일형 org-info 컬렉션에서 가져온다(하드코딩 폐지).
const orgInfo = await getEntry('org-info', 'info');

interface Props {
  pageName: string;
  searchable?: boolean;
  // 목업 실측 — <main> 바로 아래, 뷰포트 폭까지 꽉 차는 배경색 wrapper(스크린리더 이름 없는
  // 순수 시각 요소)가 각 페이지 색을 깔고, 그 안의 <section>들이 개별 배경을 덮어 그린다.
  // 특정 section이 자기 배경을 안 칠하면 이 wrapper 색이 안전망으로 비친다. 지금까지는
  // <main class="wrap">이 이 wrapper 역할까지 겸하면서 1200px로 콘텐츠 폭에 갇혀 있었다
  // (모든 메뉴 페이지에서 배경색이 좌우 끝까지 안 퍼지고, 흐르는 갤러리도 잘리는 원인).
  bg?: string;
}
const { pageName, searchable = true, bg = 'var(--bg)' } = Astro.props;

const title = `${pageName} – ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Astro.url.pathname은 한글 경로를 퍼센트 인코딩한 상태로 준다(/%ED%9B%84...) — MAIN_MENU의
// href는 평문 한글이라 디코딩 없이 비교하면 절대 안 맞는다(모든 한글 라우트에서 현재 메뉴
// 표시·aria-current가 계속 실패하고 있었음 — 실측으로 발견, 수정).
const path = decodeURIComponent(Astro.url.pathname);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 가장 넓게 쓰이는 굵기 2개만 preload — 본문(Pretendard Regular)과 제목(NanumSquareRound
         ExtraBold, 대부분 페이지의 히어로/섹션 제목에 쓰여 LCP 후보가 됨). 나머지 굵기는
         특정 구간에서만 쓰여서 전부 preload하면 오히려 초기 로딩 대역폭을 낭비한다. -->
    <link rel="preload" href="/fonts/Pretendard-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/NanumSquareRoundEB.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {NOINDEX && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a href="#main-content" class="skip">본문으로 바로가기</a>

    <header class="site-header">
      <div class="head wrap">
        <a class="brand" href="/" aria-label={`${ORG_FULL_NAME} 홈으로`} aria-describedby="logo-desc">
          <img src="/images/logo-mark.png" alt="" class="brand-logo" />
          <span id="logo-desc" class="sr-only">
            좋은비전 로고: 분홍, 노랑, 하늘, 초록 — 동그라미 머리에 타원 몸을 한 사람 형상 넷이 어깨를 맞대고 나란히 섰다. 키도 색도 제각각인데, 함께 서니 화음처럼 어우러진다.
          </span>
          <span class="brand-name">{ORG_FULL_NAME}</span>
        </a>

        <div class="head-tools">
          <form class="search-form" action="#" role="search" id="site-search-form">
            <label for="site-search">검색</label>
            <input id="site-search" type="search" name="q" placeholder="예: 상담 신청, 후원 계좌, 강의" autocomplete="off" />
            <button type="submit" class="btn">검색</button>
          </form>
          <div class="head-controls">
            <div role="group" aria-label="글자 크기" class="zoom-steps">
              <span id="fontsize-label" class="zoom-group-label">글자 크기</span>
              <button type="button" data-size="0" aria-pressed="true" aria-label="글자 크기 보통, 100%"><span class="sz-name">보통</span> <span>100%</span></button>
              <button type="button" data-size="1" aria-pressed="false" aria-label="글자 크기 조금 크게, 125%"><span class="sz-name">조금 크게</span> <span>125%</span></button>
              <button type="button" data-size="2" aria-pressed="false" aria-label="글자 크기 크게, 150%"><span class="sz-name">크게</span> <span>150%</span></button>
              <button type="button" data-size="3" aria-pressed="false" aria-label="글자 크기 가장 크게, 200%"><span class="sz-name">가장 크게</span> <span>200%</span></button>
            </div>
            <button type="button" id="hc-toggle" aria-pressed="false" aria-label="고대비 화면 켜기, 꺼져 있음">고대비</button>
          </div>
        </div>
      </div>

      <nav aria-label="주 메뉴" class="primary-nav">
        <ul class="nav-list wrap">
          {MAIN_MENU.map((item) => {
            // 페이지네이션처럼 /소식/페이지/2/ 같은 하위 경로도 "소식" 탭을 활성으로 표시해야
            // 해서 접두사 매칭도 허용한다. MAIN_MENU의 href는 전부(홈 제외) 슬래시로 끝나므로
            // "/소식-후기/" 같은 다른 이름의 페이지가 "/소식/"에 잘못 매칭될 일은 없다.
            // extraActivePaths — URL이 href 밑에 중첩되지 않은 예외 하위 페이지(예: 기부금 공시).
            const active = path === item.href
              || (item.href !== '/' && path.startsWith(item.href))
              || (item.extraActivePaths?.some((p) => path.startsWith(p)) ?? false);
            const style = active ? `--tab-bg:${item.tab};--tab-ink:${item.tabInk};--tab-page-bg:${item.pageBg}` : undefined;
            return <li><a href={item.href} aria-current={active ? 'page' : undefined} style={style}>{item.label}</a></li>;
          })}
        </ul>
      </nav>
    </header>

    <div id="search-results" class="search-results" hidden>
      <div class="wrap">
        <div class="search-results-head">
          <h2 id="search-results-title" tabindex="-1">검색 결과</h2>
          <button type="button" id="search-close" class="btn-outline">검색 결과 닫기</button>
        </div>
        <p id="search-status" class="sr-only" aria-live="polite"></p>
        <p id="search-empty" class="search-empty" hidden>찾으시는 내용이 없습니다. 다른 낱말로 검색해보시거나, 전문상담 {orgInfo.data.phone}으로 전화 주시면 안내드립니다.</p>
        <ul id="search-list" class="search-list"></ul>
      </div>
    </div>

    <main id="main-content" class="main" data-pagefind-body={searchable || undefined} data-pagefind-ignore={!searchable || undefined}>
      <div class="page-bg" style={`background:${bg}`}>
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div>
          <div class="footer-brand">
            <img src="/images/logo-mark.png" alt="" class="footer-logo" />
            <span>{ORG_FULL_NAME}</span>
          </div>
          <address>
            {orgInfo.data.address} <br />
            부설 좋은비전재활상담연구소
          </address>
          <nav aria-label="푸터 메뉴" class="footer-nav">
            {FOOTER_MENU.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
        </div>
        <div class="footer-contact">
          <p class="footer-contact-label">전문상담 · 대표전화</p>
          <a href={telHref(orgInfo.data.phone)} aria-label={`전문상담 대표전화 ${orgInfo.data.phone}, 선택하면 전화가 연결됩니다`} class="footer-phone">{orgInfo.data.phone}</a>
          <p class="footer-hours">평일 09:00 – 18:00</p>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="wrap">© {ORG_FULL_NAME}</p>
      </div>
    </footer>

    <script define:vars={{ searchable }}>
      (() => {
        const root = document.documentElement;
        const SIZES = [1, 1.25, 1.5, 2];

        // 글자 크기 4단계 — em 배율. 저장값을 방문마다 복원한다.
        const applySize = (i) => {
          root.style.setProperty('--zoom', String(SIZES[i]));
          document.querySelectorAll('.zoom-steps button').forEach((b, idx) => b.setAttribute('aria-pressed', idx === i ? 'true' : 'false'));
          localStorage.setItem('goodvision-size', String(i));
        };
        const savedSize = parseInt(localStorage.getItem('goodvision-size'), 10);
        applySize(Number.isInteger(savedSize) && savedSize >= 0 && savedSize < SIZES.length ? savedSize : 0);
        document.querySelectorAll('.zoom-steps button').forEach((b) =>
          b.addEventListener('click', () => applySize(Number(b.dataset.size))),
        );

        // 고대비 토글.
        const hcToggle = document.getElementById('hc-toggle');
        const applyHc = (on) => {
          root.classList.toggle('hc', on);
          hcToggle.setAttribute('aria-pressed', on ? 'true' : 'false');
          hcToggle.setAttribute('aria-label', on ? '고대비 화면 끄기, 켜져 있음' : '고대비 화면 켜기, 꺼져 있음');
          localStorage.setItem('goodvision-hc', on ? '1' : '0');
        };
        applyHc(localStorage.getItem('goodvision-hc') === '1');
        hcToggle.addEventListener('click', () => applyHc(!root.classList.contains('hc')));

        // 2026-08-20(test/skip-no-focus 실험 브랜치 전용) — 한/영 전환 안 되는 문제를
        // 격리 조사하기 위해 스킵링크의 programmatic focus(main.focus())를 완전히 제거.
        // reference(a11y.xvtech.com)의 skip target처럼 순수 네이티브 anchor로만 동작 —
        // main#main-content의 tabindex="-1"도 아래에서 제거해 정적 콘텐츠에 실제 키보드
        // 포커스가 전혀 안 가게 만든다. 이 브랜치는 main에 병합하지 않는다.

        // 다른 페이지의 #앵커로 이동(푸터 "오시는 길"·"부설연구소")할 때 — 일반 다중 페이지
        // 이동은 브라우저가 포커스를 새로 초기화해 스크린리더가 새 <title>을 읽지만,
        // #해시가 붙은 이동은 브라우저가 스크롤만 하고 포커스는 안 옮기는 경우가 많다
        // (표준 동작이 아니라 브라우저마다 다름). 목업의 performJump()처럼 해시 대상
        // 제목으로 직접 초점을 옮겨 시각적 위치와 읽기 위치를 일치시킨다.
        const jumpToHash = () => {
          const id = decodeURIComponent(location.hash.slice(1));
          if (!id) return;
          const target = document.getElementById(id);
          if (!target) return;
          if (target.getAttribute('tabindex') === null) target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
          window.scrollTo(0, target.getBoundingClientRect().top + window.scrollY - 24);
        };
        if (location.hash) requestAnimationFrame(jumpToHash);
        window.addEventListener('hashchange', jumpToHash);

        // 읽기 위치 표시 — 스크린리더 가상 커서(화살표 이동)는 DOM 포커스를 옮기지 않아
        // :focus-visible이 안 걸린다. selectionchange로 가상 커서 위치를 따라간다.
        let readingEl = null;
        let pointerDown = false;
        let pointerAt = 0;
        const clearReading = () => {
          if (readingEl) { readingEl.classList.remove('reading-cursor'); readingEl = null; }
        };
        const markReading = (node) => {
          const el = node && node.nodeType === 3 ? node.parentElement : node;
          if (!el || el.nodeType !== 1 || el === readingEl) return;
          if (el.closest('[aria-hidden="true"]')) return;
          clearReading();
          el.classList.add('reading-cursor');
          readingEl = el;
        };
        document.addEventListener('pointerdown', () => { pointerDown = true; pointerAt = performance.now(); clearReading(); }, true);
        document.addEventListener('pointerup', () => { pointerDown = false; pointerAt = performance.now(); }, true);
        document.addEventListener('selectionchange', () => {
          if (pointerDown) return;
          if (pointerAt && performance.now() - pointerAt < 600) return;
          const s = document.getSelection();
          if (s && s.anchorNode) markReading(s.anchorNode);
        });

        // 검색 — /search-index.json을 받아 클라이언트에서 필터링, 페이지 이동 없이 결과를 보여준다.
        const form = document.getElementById('site-search-form');
        const input = document.getElementById('site-search');
        const panel = document.getElementById('search-results');
        const list = document.getElementById('search-list');
        const empty = document.getElementById('search-empty');
        const status = document.getElementById('search-status');
        const closeBtn = document.getElementById('search-close');
        let indexPromise;
        const loadIndex = () => {
          if (!indexPromise) indexPromise = fetch('/search-index.json').then((r) => r.json());
          return indexPromise;
        };
        const closeSearch = (focusInput = false) => {
          panel.hidden = true;
          if (focusInput) input.focus();
        };
        closeBtn.addEventListener('click', () => closeSearch(true));
        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const q = input.value.trim();
          if (!q) return;
          const words = q.toLowerCase().split(/\s+/);
          const items = await loadIndex();
          const results = items.filter((item) => {
            const hay = `${item.title} ${item.snippet} ${item.keys} ${item.page}`.toLowerCase();
            return words.some((w) => hay.includes(w));
          });
          list.innerHTML = results
            .map(
              (r) => `<li><a href="${r.href}">
                <span class="search-page-label">${r.page} 페이지</span>
                <span class="search-title">${r.title}</span>
                <span class="search-snippet">${r.snippet}</span>
              </a></li>`,
            )
            .join('');
          empty.hidden = results.length !== 0;
          status.textContent = `'${q}' 검색 결과 ${results.length}건입니다.`;
          panel.hidden = false;
          document.getElementById('search-results-title').focus();
        });

        if (!searchable) return; // 검색 자기 자신을 색인하지 않는 페이지 표시만, 동작은 동일.

        document.addEventListener('keydown', (event) => {
          const tag = event.target?.tagName?.toLowerCase();
          if (event.key === 'F2' && tag !== 'input' && tag !== 'textarea') {
            event.preventDefault();
            input?.focus();
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  @font-face { font-family: Pretendard; font-weight: 400; font-style: normal; font-display: swap; src: url('/fonts/Pretendard-Regular.woff2') format('woff2'); }
  @font-face { font-family: Pretendard; font-weight: 600; font-style: normal; font-display: swap; src: url('/fonts/Pretendard-SemiBold.woff2') format('woff2'); }
  @font-face { font-family: Pretendard; font-weight: 700; font-style: normal; font-display: swap; src: url('/fonts/Pretendard-Bold.woff2') format('woff2'); }
  @font-face { font-family: Pretendard; font-weight: 800; font-style: normal; font-display: swap; src: url('/fonts/Pretendard-ExtraBold.woff2') format('woff2'); }
  @font-face { font-family: NanumSquareRound; font-weight: 400; font-style: normal; font-display: swap; src: url('/fonts/NanumSquareRound.woff2') format('woff2'); }
  @font-face { font-family: NanumSquareRound; font-weight: 700; font-style: normal; font-display: swap; src: url('/fonts/NanumSquareRoundB.woff2') format('woff2'); }
  @font-face { font-family: NanumSquareRound; font-weight: 800; font-style: normal; font-display: swap; src: url('/fonts/NanumSquareRoundEB.woff2') format('woff2'); }

  :root {
    --zoom: 1;
    --bg: #f7f3e8;
    --paper: #fff;
    --ink: #3a3626;
    --muted: #5c5640;
    --line: #e9e1cb;
    --green: #17694f;
    --green-dark: #0f5238;
    font-size: calc(100% * var(--zoom));
    /* 목업 원본 주석(그대로 옮김): 움직임 최소화 설정을 존중한다(원칙 38). 글자 크기
       0.3초 전환은 본문 전체가 리플로우되며 커지는 큰 움직임이라 어지럼증·전정기관
       장애가 있는 사용자에게는 부담이다 — 그래서 흐르는 갤러리처럼 이 전환도
       prefers-reduced-motion:reduce에서 꺼져야 한다(아래 전역 규칙이 처리). */
    transition: font-size 0.3s ease;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--ink);
    margin: 0;
    font-family: Pretendard, system-ui, sans-serif;
    line-height: 1.68;
    -webkit-font-smoothing: antialiased;
  }
  main, header, footer { word-break: keep-all; overflow-wrap: break-word; }
  a { color: var(--green); text-underline-offset: 3px; }
  a:hover { color: var(--green-dark); }
  a[href^='tel:'] { text-decoration: underline !important; text-underline-offset: 3px; }
  button, input { font: inherit; }
  button, .btn, .btn-outline {
    cursor: pointer;
    border-radius: 9px;
    min-height: 44px;
    padding: 0.6rem 1.1rem;
    font-weight: 700;
  }
  .btn {
    background: var(--green);
    border: 1.5px solid var(--green);
    color: #fff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .btn.alt { background: #664c27; border-color: #664c27; }
  .btn-outline {
    background: #fff;
    border: 1.5px solid var(--line);
    color: var(--ink);
  }

  main h2[id], main h3[id] { scroll-margin-top: 24px; }
  :focus-visible { outline: 3px solid #1a1512; outline-offset: 2px; box-shadow: 0 0 0 5px #fff; }
  nav[aria-label='주 메뉴'] a:focus-visible, .footer :focus-visible { outline: 3px solid #fff; outline-offset: 2px; box-shadow: 0 0 0 5px #1a1512; }
  main:focus:not(:focus-visible) { outline: none; }
  main:focus-visible { outline: 3px solid #1a1512; outline-offset: -4px; }

  .reading-cursor:not(:focus-visible) { outline: 3px solid #6b4a2f !important; outline-offset: 2px !important; }
  html.hc .reading-cursor:not(:focus-visible) { outline: 3px solid #ffe800 !important; outline-offset: 2px !important; }
  nav[aria-label='주 메뉴'] .reading-cursor:not(:focus-visible), .footer .reading-cursor:not(:focus-visible) { outline-color: #f0dcc4 !important; }
  .reading-cursor { transition: none !important; }
  p.reading-cursor, li.reading-cursor, h1.reading-cursor, h2.reading-cursor, h3.reading-cursor,
  dd.reading-cursor, dt.reading-cursor, td.reading-cursor, th.reading-cursor { background-color: #fdf6ea !important; }
  html.hc p.reading-cursor, html.hc li.reading-cursor, html.hc h1.reading-cursor, html.hc h2.reading-cursor,
  html.hc h3.reading-cursor, html.hc dd.reading-cursor, html.hc dt.reading-cursor, html.hc td.reading-cursor,
  html.hc th.reading-cursor { background-color: #141414 !important; }

  :where(section, div, header, footer, main, article, aside, ul, ol, li, p, h1, h2, h3, h4, dl, dt, dd,
    table, thead, tbody, tr, td, th, span, figure, figcaption, nav, form, label, address) {
    transition: background-color 0.22s ease, color 0.22s ease, border-color 0.22s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
    }
  }
  @media (forced-colors: active) {
