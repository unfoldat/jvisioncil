---
// 2026-08-17 디자인 목업 반영 — 홈. 섹션 구성은 목업과 완전히 동일하게 유지하고,
// 기부금 공시 작업지시서 §3(홈 하단 최신 3건 미리보기)만 목업에 없던 내용으로 별도 추가한다.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import { reportTitle, sortForList, fileSizeLabel } from '../lib/donationReports';

const reports = sortForList(await getCollection('donation-reports')).slice(0, 3);

// 활동 사진 — 페이지마다 독립된 배열(나중에 홈·후원안내를 다른 사진으로 바꾸기 쉽게 공유 lib로 묶지 않음).
const PHOTOS = [
  { src: '/images/gallery/01.jpg', alt: '정기총회 현장, 발표자가 마이크를 들고 인사말을 하는 모습과 박수치는 참석자들' },
  { src: '/images/gallery/02.jpg', alt: '도자기 교실에서 참가자가 흙을 빚는 손 클로즈업' },
  { src: '/images/gallery/03.jpg', alt: '실내 강연장에서 발표자가 스크린 앞에서 이야기하는 모습' },
  { src: '/images/gallery/04.jpg', alt: '붉은 흙길 산행로를 걷는 참가자들, 흰지팡이를 든 참가자 포함' },
  { src: '/images/gallery/05.jpg', alt: '두 사람이 협약서를 나란히 들고 있는 모습, 뒤로 음악회 포스터' },
  { src: '/images/gallery/06.jpg', alt: '점자책을 손으로 짚어 읽는 시각장애인과 옆에서 함께 짚어주는 담당자, 흰지팡이가 탁자 위에 놓여 있음' },
  { src: '/images/gallery/07.jpg', alt: '한궁 과녁과 사진 전시가 있는 실내 공간에서 참가자들이 대화하는 모습' },
  { src: '/images/gallery/08.jpg', alt: '한옥 앞 단체사진, "좋은비전과 함께하는 봄,여름,가을,겨울 후원 앤시스코리아" 현수막을 흰지팡이를 든 참가자가 들고 있음' },
  { src: '/images/gallery/09.jpg', alt: '두 사람이 장학증서를 함께 들고 있는 모습' },
  { src: '/images/gallery/10.jpg', alt: '서울필로스합창단 단원들이 무대에서 합창하는 모습' },
  { src: '/images/gallery/11.jpg', alt: '녹음 부스에서 여러 명이 원고를 들고 마이크 앞에 서 있는 모습(낭독 녹음)' },
];
const galleryLoop = PHOTOS.concat(PHOTOS);
---

<BaseLayout pageName="홈">
  <section class="hero" aria-labelledby="home-hero">
    <div class="wrap hero-grid">
      <div>
        <h1 id="home-hero">
          <span class="hero-lead">보는 방법은 달라도,</span>{' '}
          <span class="hero-strong">꿈을 바라보는 <br />마음은 같습니다</span>
        </h1>
        <p class="hero-copy">
          좋은비전장애인자립생활센터는 시각장애인과 특히 중도실명인이 실명 이후에도 자신의 삶을 스스로 선택하고 결정하며, 지역사회의 한 구성원으로 함께 살아갈 수 있도록 지원합니다.
        </p>
      </div>
      <div class="hero-mark">
        <img src="/images/logo-mark.png" alt="좋은비전 로고: 분홍, 노랑, 하늘, 초록 — 동그라미 머리에 타원 몸을 한 사람 형상 넷이 어깨를 맞대고 나란히 섰다. 키도 색도 제각각인데, 함께 서니 화음처럼 어우러진다." />
      </div>
    </div>
  </section>

  <section aria-labelledby="home-cards">
    <div class="wrap">
      <h2 id="home-cards">주요 서비스</h2>
      <div class="card-grid card-grid-4">
        <a href="/상담안내/" class="service-card sc-orange">
          <h3>전문상담</h3>{' '}
          <span>중도실명 컨설팅, 심리평가, 청소년 진로상담을 안내합니다.</span>{' '}
          <span class="service-card-cta">상담 안내 보기 →</span>
        </a>
        <a href="/강의/" class="service-card sc-rose">
          <h3>강의 신청</h3>{' '}
          <span>직장 내·사회적 장애인식개선 교육, 실명예방 교육을 신청합니다.</span>{' '}
          <span class="service-card-cta">강의 안내 보기 →</span>
        </a>
        <a href="https://www.1365.go.kr/vols/P9140/srvcinfo/volsDnttInfo.do?titleNm=%EC%83%81%EC%84%B8%EB%B3%B4%EA%B8%B0&type=show&nanmmbyId=30757747" class="service-card sc-green">
          <h3>봉사 신청</h3>{' '}
          <span>외출 동행, 오디오북 제작, 행사 진행 등을 지원합니다.</span>{' '}
          <span class="service-card-cta">1365 자원봉사포털에서 신청하기 →</span>
        </a>
        <a href="/후원안내/" class="service-card sc-teal">
          <h3>후원</h3>{' '}
          <span class="service-card-cta">후원 안내 보기 →</span>
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="home-first" class="band">
    <div class="wrap band-grid">
      <div>
        <h2 id="home-first">처음 오셨나요? (상담/Q&A)</h2>
        <p>갑작스러운 실명으로 새로운 삶에 적응해야 하는 시기에는 무엇부터 확인해야 할지 막막합니다. 복지서비스, 교육, 직업, 일상생활 적응까지 순서대로 안내합니다.</p>
        <a href="/상담안내/" class="btn">처음 오신 분 안내 보기</a>
      </div>
      <div class="band-figure" aria-hidden="true">
        <img src="/images/first-visit.png" alt="" />
      </div>
    </div>
  </section>

  <section aria-labelledby="home-donate">
    <div class="wrap">
      <div class="donate-cta">
        <h2 id="home-donate">좋은비전의 활동을 함께 응원해주세요</h2>
        <p>여러분의 후원이 상담과 교육, 낭독도서 제작 활동을 이어갑니다.</p>
        <a href="/후원안내/" class="btn btn-lg">후원 안내 보기</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="home-gallery" class="band">
    <h2 id="home-gallery" class="wrap">활동 사진</h2>
    <div class="marquee">
      <div class="marquee-track">
        {galleryLoop.map((photo, i) => (
          <img class="marquee-item" src={photo.src} alt={i >= PHOTOS.length ? '' : photo.alt} aria-hidden={i >= PHOTOS.length ? 'true' : undefined} loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="home-partners">
    <div class="wrap">
      <h2 id="home-partners">함께하는 기관 <span class="section-sub">MOU 협력기관</span></h2>
      <PartnerGrid compact />
      <a href="/기부금-공시/" class="disclosure-teaser">
        <span class="disclosure-teaser-title">기부금 공시 내역</span>{' '}
        <span class="disclosure-teaser-sub">연간 기부금 모금액과 활용실적 보고서 보기 →</span>
      </a>
    </div>
  </section>

  <!-- 목업엔 없던 섹션 — 기부금 공시 작업지시서 §3(홈 하단 최신 3건 미리보기)만 추가. -->
  <section aria-labelledby="home-disclosures" class="band">
    <div class="wrap">
      <h2 id="home-disclosures">기부금 공시</h2>
      {reports.length === 0 ? (
        <p>공개된 기부금 공시 내역이 아직 없습니다.</p>
      ) : (
        <ul class="disclosure-preview">
          {reports.map((report) => {
            const title = reportTitle(report);
            const size = fileSizeLabel(report.data.file);
            return <li><a href={report.data.file} download>{title} PDF 다운로드 ({size})</a></li>;
          })}
        </ul>
      )}
      <a href="/기부금-공시/" class="standalone-link">전체보기 →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: #f9f5ea; border-bottom: 1px solid var(--line); }
  .hero-grid { padding: 70px 0 66px; display: grid; grid-template-columns: 1.35fr 0.65fr; gap: 48px; align-items: center; }
  #home-hero { margin: 0; font-family: NanumSquareRound, Pretendard, sans-serif; letter-spacing: -0.03em; max-width: 22em; }
  .hero-lead { display: block; font-weight: 400; font-size: 2.1em; line-height: 1.45; color: var(--muted); }
  .hero-strong { display: block; font-weight: 800; font-size: 3.1em; line-height: 1.3; color: #14513c; text-wrap: pretty; }
  .hero-copy { margin: 28px 0 0; padding-left: 20px; border-left: 5px solid var(--green); font: 400 1.32em/1.8 Pretendard, system-ui, sans-serif; color: var(--muted); max-width: 34em; text-wrap: pretty; }
  .hero-mark { display: flex; align-items: center; justify-content: center; padding: 34px; background: #fff; border: 1px solid #cbe7d8; border-radius: 24px; }
  .hero-mark img { width: 100%; max-width: 15em; height: auto; display: block; }

  section[aria-labelledby] > .wrap, section.band { padding: 46px 0 58px; }
  section[aria-labelledby='home-cards'] h2, section[aria-labelledby='home-news'] h2, #home-gallery { margin: 0 0 22px; font: 800 1.7em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }

  .card-grid { display: grid; gap: 18px; }
  .card-grid-4 { grid-template-columns: repeat(4, 1fr); }
  .service-card {
    display: flex; flex-direction: column; gap: 10px; padding: 30px 26px 26px; border-radius: 4px 4px 16px 16px;
    text-decoration: none; color: #332e1e; min-height: 14em; border-top: 5px solid;
  }
  .service-card h3 { margin: 0; font: 800 1.62em/1.3 NanumSquareRound, Pretendard, sans-serif; }
  .service-card span { font: 400 1.06em/1.65 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }
  .service-card-cta { margin-top: auto; font: 700 1.06em/1 NanumSquareRound, Pretendard, sans-serif !important; color: inherit !important; }
  .sc-orange { background: #f6decf; border-color: #d97736; }
  .sc-rose { background: #f4e4e4; border-color: #c87a7a; }
  .sc-green { background: #e4f1e9; border-color: #17694f; }
  .sc-teal { background: #e5eded; border-color: #6c9a9c; }

  .band { background: #f9f5ea; border-top: 1px solid #ece5d2; border-bottom: 1px solid #ece5d2; }
  .band-grid { display: grid; grid-template-columns: 1.12fr 0.88fr; gap: 44px; align-items: center; }
  #home-first { margin: 0 0 16px; font: 800 2.1em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  .band-grid p { margin: 0 0 26px; font: 400 1.25em/1.8 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); max-width: 30em; text-wrap: pretty; }
  .band-figure { border: 1px solid var(--line); border-radius: 16px; background: #f9f5ea; min-height: 14em; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .band-figure img { width: 100%; max-width: 26em; height: auto; display: block; border-radius: 8px; }

  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 22px; }
  .section-head h2 { margin: 0; font: 800 1.7em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }

  .donate-cta { border: 3px solid #bdd2d2; border-radius: 20px; background: #f2f6f6; padding: 48px 44px; text-align: center; }
  #home-donate { margin: 0 0 14px; font: 800 2.3em/1.35 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  .donate-cta p { margin: 0 0 30px; font: 400 1.32em/1.7 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }
  .btn-lg { padding: 20px 40px; font: 800 1.44em/1 NanumSquareRound, Pretendard, sans-serif !important; min-height: 0; }

  .marquee { overflow: hidden; }
  .marquee-track { display: flex; gap: 18px; width: max-content; animation: marquee 120s linear infinite; }
  .marquee:hover .marquee-track, .marquee:focus-within .marquee-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .marquee-item {
    width: 19em; height: 12.6em; flex: none; border-radius: 14px; background: #fff;
    object-fit: cover; display: block;
  }

  #home-partners { margin: 0 0 18px; font: 800 1.38em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  .section-sub { font: 400 0.68em/1 Pretendard, system-ui, sans-serif; color: #6b6550; margin-left: 0.4em; }
  .disclosure-box {
    margin-top: 26px; padding: 18px 24px;
    border: 1.5px solid #bdd2d2; border-radius: 12px; background: #f2f6f6; color: #3a3626;
  }
  .disclosure-box-title { margin: 0 0 10px; font: 800 1.13em/1.4 NanumSquareRound, Pretendard, sans-serif; }
  .disclosure-preview { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 6px; }
  .disclosure-preview a { font: 600 0.97em/1.5 NanumSquareRound, Pretendard, sans-serif; }
  .disclosure-teaser-sub { display: inline-block; font: 400 0.94em/1.5 NanumSquareRound, Pretendard, sans-serif; color: #6b6550; }

  @media (max-width: 860px) { .card-grid-4 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) {
    .hero-grid, .band-grid { grid-template-columns: minmax(0, 1fr); padding: 30px 0; }
    #home-hero { font-size: 1.9em; }
    .hero-lead { font-size: 1.15em; line-height: 1.45; }
    .hero-strong { font-size: 1.7em; line-height: 1.3; }
    .hero-copy { font-size: 1.06em; line-height: 1.75; padding-left: 14px; }
  }
  @media (max-width: 640px) { .card-grid-4 { grid-template-columns: minmax(0, 1fr); } }
</style>
