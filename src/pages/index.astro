---
// 2026-08-17 디자인 목업 반영 — 홈. 섹션 구성은 목업과 완전히 동일하게 유지한다.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerGrid from '../components/PartnerGrid.astro';
import NoticeList from '../components/NoticeList.astro';

// 활동 사진 — 확정 스키마 결정: 소식과 분리된 공유 gallery 컬렉션, "노출 위치"
// 체크박스로 페이지별 필터링(지금은 3곳 다 같은 사진이라 필터 결과도 동일).
const PHOTOS = (await getCollection('gallery'))
  .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))
  .filter((entry) => entry.data.showOn.includes('home'))
  .map((entry) => ({ src: entry.data.photo, alt: entry.data.alt ?? '' }));
const galleryLoop = PHOTOS.concat(PHOTOS);

// 2026-08-25 홈 소식 미리보기 — showOnHome 체크된 글 중 최신순 최대 3개.
// pinned(목록 상단 고정)와는 완전히 독립된 필터라 그쪽 정렬 로직(sortForList)을
// 재사용하지 않고 여기서 날짜만으로 직접 정렬한다.
const homeNotices = (await getCollection('notices'))
  .filter((n) => n.data.showOnHome)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout pageName="홈" bg="#F7F3E8">
  <section class="hero" aria-labelledby="home-hero">
    <div class="wrap hero-grid">
      <div>
        <h1 id="home-hero">
          <span class="hero-lead">보는 방법은 달라도,</span>{' '}
          <span class="hero-strong">꿈을 바라보는 <br />마음은 같습니다</span>
        </h1>
        <p class="hero-copy">
          좋은비전장애인자립생활센터는 시각장애인과 특히 중도실명인이 실명 이후에도 자신의 삶을 스스로 선택하고 결정하며, 지역사회의 한 구성원으로 함께 살아갈 수 있도록 지원합니다.
        </p>
      </div>
      <div class="hero-mark">
        <img src="/images/logo-mark.png" alt="좋은비전 로고: 분홍, 노랑, 하늘, 초록 — 동그라미 머리에 타원 몸을 한 사람 형상 넷이 어깨를 맞대고 나란히 섰다. 키도 색도 제각각인데, 함께 서니 화음처럼 어우러진다." />
      </div>
    </div>
  </section>

  <section aria-labelledby="home-cards">
    <div class="wrap">
      <h2 id="home-cards">주요 서비스</h2>
      <div class="card-grid card-grid-4">
        <a href="/상담안내/" class="service-card sc-orange">
          <h3>전문상담</h3>{' '}
          <span>중도실명 컨설팅, 심리평가, 청소년 진로상담을 안내합니다.</span>{' '}
          <span class="service-card-cta">상담 안내 보기 →</span>
        </a>
        <a href="/강의/" class="service-card sc-rose">
          <h3>강의 신청</h3>{' '}
          <span>직장 내·사회적 장애인식개선 교육, 실명예방 교육을 신청합니다.</span>{' '}
          <span class="service-card-cta">강의 안내 보기 →</span>
        </a>
        <div class="service-card sc-green">
          <h3>봉사 신청</h3>{' '}
          <span>외출 동행, 오디오북 제작, 행사 진행 등을 지원합니다.</span>{' '}
          <div class="service-card-links">
            <a href="/qa/#volunteer1365" class="service-card-cta" aria-label="봉사 신청 안내 보기">안내 보기 →</a>
            <a href="https://www.1365.go.kr/vols/P9140/srvcinfo/volsDnttInfo.do?titleNm=%EC%83%81%EC%84%B8%EB%B3%B4%EA%B8%B0&type=show&nanmmbyId=30757747" class="service-card-cta" aria-label="1365 자원봉사포털에서 신청하기">신청하기 →</a>
          </div>
        </div>
        <a href="/후원안내/" class="service-card sc-teal">
          <h3>후원</h3>{' '}
          <span>좋은비전의 활동을 함께 응원해주세요.</span>{' '}
          <span class="service-card-cta">후원 안내 보기 →</span>
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="home-first" class="band first-visit">
    <div class="wrap first-visit-banner">
      <div>
        <h2 id="home-first">처음 오셨나요? (상담/Q&A)</h2>
        <p>갑작스러운 실명으로 새로운 삶에 적응해야 하는 시기에는 무엇부터 확인해야 할지 막막합니다.<br />장애 수용과 재활, 자립생활, 상담에 필요한 정보를 차근차근 안내합니다.</p>
        <a href="/qa/" class="btn">처음 오신 분 안내 보기</a>
      </div>
      <img src="/images/first-visit.png" alt="" aria-hidden="true" />
    </div>
  </section>

  {homeNotices.length > 0 && (
    <section aria-labelledby="home-news" class="band">
      <div class="wrap">
        <h2 id="home-news">최근 소식</h2>
        <NoticeList notices={homeNotices} empty="" compact />
        <div class="section-foot">
          <a href="/소식/" class="section-foot-link">전체 소식 보기 →</a>
        </div>
      </div>
    </section>
  )}

  <section aria-labelledby="home-donate">
    <div class="wrap">
      <div class="donate-cta">
        <h2 id="home-donate">좋은비전의 활동을 함께 응원해주세요</h2>
        <p>여러분의 후원이 상담과 교육, 낭독도서 제작 활동을 이어갑니다.</p>
        <a href="/후원안내/" class="btn btn-lg">후원 안내 보기</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="home-gallery" class="band">
    <h2 id="home-gallery" class="wrap">활동 사진</h2>
    <div class="marquee wrap">
      <div class="marquee-track">
        {galleryLoop.map((photo, i) => (
          <img class="marquee-item" src={photo.src} alt={i >= PHOTOS.length ? '' : photo.alt} aria-hidden={i >= PHOTOS.length ? 'true' : undefined} loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="home-partners">
    <div class="wrap">
      <h2 id="home-partners">함께하는 기관 <span class="section-sub">MOU 협력기관</span></h2>
      <PartnerGrid compact />
      <a href="/기부금-공시/" class="disclosure-teaser">
        <span class="disclosure-teaser-title">기부금 공시 내역</span>{' '}
        <span class="disclosure-teaser-sub">연간 기부금 모금액과 활용실적 보고서 보기 →</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* section[aria-labelledby] > .wrap의 범용 padding(바로 아래)이 이 페이지의 모든
     .wrap을 잡는다. .hero-grid/.first-visit처럼 다른 padding이 필요한 곳은 specificity로
     이기려 들면 계속 술래잡기가 된다(실측으로 확인: :not()/:where() 둘 다 Astro의 CSS
     스코프 속성 부착 방식 때문에 예측과 다르게 계산됨) — 그래서 이 두 곳만 명확하게
     !important로 예외 처리한다. */
  section[aria-labelledby] > .wrap, section.band { padding: 46px 0 58px; }

  .hero { background: #f9f5ea; border-bottom: 1px solid var(--line); }
  .hero-grid { padding: 70px 0 66px !important; display: grid; grid-template-columns: 1.35fr 0.65fr; gap: 48px; align-items: center; }
  #home-hero { margin: 0; font-family: NanumSquareRound, Pretendard, sans-serif; letter-spacing: -0.03em; max-width: 22em; }
  .hero-lead { display: block; font-weight: 400; font-size: 2.1em; line-height: 1.45; color: var(--muted); }
  .hero-strong { display: block; font-weight: 800; font-size: 3.1em; line-height: 1.3; color: #14513c; text-wrap: pretty; }
  .hero-copy { margin: 28px 0 0; padding-left: 20px; border-left: 5px solid var(--green); font: 400 1.32em/1.8 Pretendard, system-ui, sans-serif; color: var(--muted); max-width: 34em; text-wrap: pretty; }
  .hero-mark { display: flex; align-items: center; justify-content: center; padding: 34px; background: #fff; border: 1px solid #cbe7d8; border-radius: 24px; }
  .hero-mark img { width: 100%; max-width: 15em; height: auto; display: block; }

  section[aria-labelledby='home-cards'] h2, section[aria-labelledby='home-news'] h2 { margin: 0 0 22px; font: 800 1.7em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  /* margin shorthand로 top/bottom만 정하면 안 된다 — 3값 shorthand는 left/right도 0으로
     같이 지정해버려서 .wrap의 margin:auto 가운데 정렬을 ID 우선순위로 덮어쓰고, 결과적으로
     제목이 화면 왼쪽 끝에 붙어버린다(실측으로 발견). top/bottom만 따로 지정해 좌우는 안 건드린다. */
  /* #home-gallery(h2)와 .marquee 둘 다 폭 정렬을 위해 .wrap 클래스를 쓰는데, 이 페이지
     위쪽의 범용 규칙(section[aria-labelledby] > .wrap)이 둘 다 직계 자식으로 잡아버려서
     section.band 자체 패딩(46/58)에 더해 h2·marquee 각각에도 같은 패딩이 또 붙어
     총 3중으로 겹쳤다(실측으로 발견 — h2 박스 높이가 텍스트 한 줄인데 142px까지 부풀어
     있었음). 여기서만 0으로 되돌린다 — section.band의 패딩 한 번만 남기면 #home-cards와
     동일한 상하 여백이 된다. */
  #home-gallery { margin-top: 0; margin-bottom: 22px; padding: 0; font: 800 1.7em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  /* 2026-08-20 — 마퀴가 보이는 창(.marquee)을 본문 폭(.wrap)에 가둔다. 움직이는
     트랙(.marquee-track)은 그대로 폭 제한 없이 흘러가고, overflow:hidden이 창 밖으로
     나간 부분만 가린다. */

  .card-grid { display: grid; gap: 18px; }
  .card-grid-4 { grid-template-columns: repeat(4, 1fr); }
  .service-card {
    display: flex; flex-direction: column; gap: 10px; padding: 30px 26px 26px; border-radius: 4px 4px 16px 16px;
    text-decoration: none; color: #332e1e; min-height: 14em; border-top: 5px solid;
  }
  .service-card h3 { margin: 0; font: 800 1.62em/1.3 NanumSquareRound, Pretendard, sans-serif; }
  .service-card span { font: 400 1.06em/1.65 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }
  .service-card-cta { margin-top: auto; font: 700 1.06em/1 NanumSquareRound, Pretendard, sans-serif !important; color: inherit !important; }
  .service-card-links { margin-top: auto; display: flex; flex-direction: column; gap: 2px; }
  .service-card-links .service-card-cta {
    margin-top: 0; margin-inline: -4px; padding: 24px 4px 0; text-decoration: none; border-radius: 6px;
  }
  .service-card-links .service-card-cta:hover, .service-card-links .service-card-cta:focus-visible { text-decoration: underline; }
  .sc-orange { background: #f6decf; border-color: #d97736; }
  .sc-orange:hover { background: #efc6ac; }
  .sc-rose { background: #f4e4e4; border-color: #c87a7a; }
  .sc-rose:hover { background: #edd3d3; }
  .sc-green { background: #e4f1e9; border-color: #17694f; }
  .sc-green:hover { background: #d3e8dc; }
  .sc-teal { background: #e5eded; border-color: #6c9a9c; }
  .sc-teal:hover { background: #d5e3e3; }

  .band { background: #f9f5ea; border-top: 1px solid #ece5d2; border-bottom: 1px solid #ece5d2; }

  /* "처음 오셨나요?" — 주요 서비스를 보조하는 배너로 읽히도록 압축(작업지시서 반영).
     히어로급 대형 섹션이 아니라 작은 온보딩 배너가 목표라 padding·이미지 폭을 크게 줄인다. */
  .first-visit.band > .wrap { padding: 20px 28px !important; }
  .first-visit-banner { display: grid; grid-template-columns: 1fr minmax(170px, 340px); align-items: center; gap: 24px; }
  #home-first { margin: 0 0 22px; font: 800 1.75em/1.3 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  .first-visit-banner p { margin: 0 0 14px; font: 400 1.19em/1.7 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); text-wrap: pretty; }
  .first-visit-banner img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; display: block; }

  /* section.band(외곽 46/58 패딩)와 section[aria-labelledby]>.wrap(같은 46/58)이
     둘 다 이 섹션에서 동시에 매치돼 패딩이 두 번 겹쳤다(#home-gallery와 동일한
     원인 — 실측으로 확인, 섹션 높이가 516px까지 부풀어 있었음). 안쪽 .wrap 패딩만
     0으로 되돌려 바깥 section.band 패딩 한 번만 남긴다. */
  section[aria-labelledby='home-news'] > .wrap { padding: 0; }
  /* 2026-08-26 — "전체 소식 보기" 링크를 제목 옆(우측 상단)에서 카드 그리드 아래로
     이동(DOM 순서도 함께 변경 — CSS 재배치가 아니라 실제 마크업 순서를 바꿔
     화살표/Tab 순서와 시각 순서를 일치시킨다). 카드 3개를 다 본 뒤 자연스럽게
     "더 보기"로 이어지도록 가운데 정렬. */
  .section-foot { margin-top: 24px; text-align: center; }
  .section-foot-link { display: inline-block; font: 700 1.06em/1 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; text-decoration: none; }
  .section-foot-link:hover, .section-foot-link:focus-visible { text-decoration: underline; }

  /* 최근 소식 미리보기 — 처음엔 홈 전용 CSS(.home-notice-card)를 새로 만들었는데
     원인 불명의 카드 크기 불일치가 발생했다(시크릿 창에서도 재현, 실측 도구로는
     끝내 원인을 못 찾음). 반면 /소식/ 페이지가 쓰는 NoticeList.astro는 3개 카드가
     항상 253.7~253.8px로 정확히 동일하게 검증됨 — 새 버그를 계속 디버깅하는 대신
     이미 검증된 컴포넌트를 그대로 재사용(compact prop으로 본문 패딩·제목 크기만
     축소, 사진 영역의 aspect-ratio/object-fit은 손대지 않음). 교훈: 다른 곳에 이미
     같은 패턴이 있으면 새로 만들기 전에 재사용부터 검토할 것. */

  /* "활동 사진" 섹션 높이(실측 310px)에 맞춰 박스 전체를 약 0.7배로 축소 — 개별
     요소를 새로 배치하지 않고 비율(폰트/패딩/여백/모서리)만 균일하게 줄인다.
     실측: 축소 전 섹션 400.6px → 이 비율로 310px대에 맞춰짐(아래 검증 참고). */
  .donate-cta { border: 3px solid #bdd2d2; border-radius: 14px; background: #f2f6f6; padding: 34px 31px; text-align: center; }
  #home-donate { margin: 0 0 10px; font: 800 1.6em/1.35 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  .donate-cta p { margin: 0 0 21px; font: 400 0.92em/1.7 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }
  .btn-lg { padding: 14px 28px; font: 800 1em/1 NanumSquareRound, Pretendard, sans-serif !important; min-height: 0; }

  .marquee { overflow: hidden; padding: 0 !important; }
  .marquee-track { display: flex; gap: 18px; width: max-content; animation: marquee 120s linear infinite; }
  .marquee:hover .marquee-track, .marquee:focus-within .marquee-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .marquee-item {
    width: 13.6em; height: 9em; flex: none; border-radius: 14px; background: #fff;
    object-fit: cover; display: block;
  }

  #home-partners { margin: 0 0 18px; font: 800 1.38em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  .section-sub { font: 400 0.68em/1 Pretendard, system-ui, sans-serif; color: #6b6550; margin-left: 0.4em; }
  .disclosure-teaser {
    display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-top: 26px; padding: 18px 24px;
    border: 1.5px solid #bdd2d2; border-radius: 12px; background: #f2f6f6; text-decoration: none; color: #3a3626;
  }
  .disclosure-teaser:hover { background: #fbf1ee; }
  .disclosure-teaser-title { font: 800 1.13em/1.4 NanumSquareRound, Pretendard, sans-serif; }
  .disclosure-teaser-sub { display: inline-block; font: 400 0.94em/1.5 NanumSquareRound, Pretendard, sans-serif; color: #6b6550; }

  @media (max-width: 860px) {
    .card-grid-4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); padding: 30px 0 !important; }
    #home-hero { font-size: 1.9em; }
    .hero-lead { font-size: 1.15em; line-height: 1.45; }
    .hero-strong { font-size: 1.7em; line-height: 1.3; }
    .hero-copy { font-size: 1.06em; line-height: 1.75; padding-left: 14px; }
  }
  @media (max-width: 640px) {
    .card-grid-4 { grid-template-columns: minmax(0, 1fr); }
    .first-visit-banner { grid-template-columns: minmax(0, 1fr); }
  }
</style>
