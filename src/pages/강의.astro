---
// 2026-08-17 디자인 목업 반영 — 강의 안내(CMS 컬렉션 없음, 목업과 동일한 정적 페이지).
import BaseLayout from '../layouts/BaseLayout.astro';

const lectures = [
  { target: '사업주 · 근로자', title: '직장 내 장애인 인식개선 교육', desc: '한국장애인고용공단 지정 수행기관으로서 법정의무교육을 실시합니다.', meta: '법정의무교육 · 1시간 기준' },
  { target: '유아 · 초등', title: '유아·아동 장애인식개선 교육', desc: '보고 듣고 만지는 체험 활동으로 시각장애를 이해합니다.', meta: '40~60분 · 체험 활동 포함' },
  { target: '청소년', title: '청소년 장애인식개선 교육', desc: '학교 생활에서 마주하는 상황을 중심으로 함께 살아가는 방법을 이야기합니다.', meta: '1차시 · 학급 단위' },
  { target: '공공기관 · 지역사회', title: '사회적 장애인식개선 교육', desc: '한국장애인개발원 강사양성과정을 수료한 강사진이 대상별 특성에 맞춰 진행합니다.', meta: '기관 요청에 따라 조정' },
  { target: '노인 · 경로당', title: '노인 실명예방 교육', desc: '노년기 눈 질환과 생활 관리, 시력 저하 시 이용할 수 있는 서비스를 안내합니다.', meta: '50분 · 자료 제공' },
  { target: '기관 맞춤', title: '중도실명 이해 교육', desc: '중도실명 당사자의 경험을 바탕으로 응대 방법과 안내 보행을 배웁니다.', meta: '요청 주제에 맞춰 구성' },
];

const tutors = [
  { name: '강사명 자리', role: '장애인식개선 교육 강사', bio: '한국장애인개발원 사회적 장애인식개선교육 강사양성과정 수료. 약력은 확인 후 채워 넣겠습니다.' },
  { name: '강사명 자리', role: '직장 내 인식개선 교육 강사', bio: '한국장애인고용공단 지정 교육기관 소속 강사. 약력은 확인 후 채워 넣겠습니다.' },
  { name: '강사명 자리', role: '재활상담 강사', bio: '좋은비전재활상담연구소 연구·상담 담당. 약력은 확인 후 채워 넣겠습니다.' },
];
---

<BaseLayout pageName="강의 안내">
  <section aria-labelledby="lc-title" class="intro">
    <div class="wrap">
      <p class="eyebrow"><span class="pill">강의 안내</span></p>
      <h1 id="lc-title">현장에서 바로 쓰이는 장애인식개선 교육</h1>
      <p class="lead-lg">한국장애인고용공단 직장 내 장애인 인식개선 교육 지정 수행기관이며, 한국장애인개발원 강사양성과정을 수료한 전문 강사진이 대상별 특성에 맞춰 교육을 진행합니다.</p>
      <a href="https://forms.gle/CaqAgMm5jQyH2bHR7" class="btn btn-lg">
        강의 신청하기 <span class="sr-only">, Google Forms로 이동</span>
      </a>
    </div>
  </section>

  <section aria-labelledby="lc-kinds" class="tint">
    <div class="wrap">
      <h2 id="lc-kinds">강의 종류</h2>
      <ul class="lecture-grid">
        {lectures.map((l) => (
          <li class="lecture-card">
            <span class="lecture-target">{l.target}</span>{' '}
            <h3>{l.title}</h3>{' '}
            <span class="lecture-desc">{l.desc}</span>{' '}
            <span class="lecture-meta">{l.meta}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="lc-lab" class="intro">
    <div class="wrap lab-grid">
      <div>
        <p class="eyebrow-sm">부설기관</p>
        <h2 id="lc-lab">좋은비전재활상담연구소</h2>
        <p class="lab-desc">현장에서 발견한 질문을 연구로 옮기고, 그 결과를 교육 과정과 강의 자료로 되돌립니다. 재활상담 프로그램 개발, 시각장애인 고용·직업만족도, 접근성, 방송·미디어와 장애인 인식 연구를 수행합니다.</p>
        <a href="/기관소개/#about-lab" class="standalone-link">센터소개에서 좋은비전재활상담연구소 자세히 보기 →</a>
      </div>
      <div class="lab-figure" aria-hidden="true">강의 현장 사진 자리</div>
    </div>
  </section>

  <section aria-labelledby="lc-tutors" class="tint">
    <div class="wrap">
      <h2 id="lc-tutors">강사 프로필</h2>
      <p class="lead-sm">강사 성명과 약력은 확인 후 채워 넣겠습니다.</p>
      <ul class="tutor-grid">
        {tutors.map((t) => (
          <li class="tutor-card">
            <div class="tutor-photo" aria-hidden="true">강사 사진 자리</div>
            <div class="tutor-body">
              <h3>{t.name}</h3>{' '}
              <span class="tutor-role">{t.role}</span>{' '}
              <span class="tutor-bio">{t.bio}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { background: #f4e4e4; padding: 62px 0 46px; }
  .tint { background: #faf2f2; padding: 58px 0; }
  .pill { display: inline-flex; padding: 6px 14px; border-radius: 999px; background: #c87a7a; color: #000; font: 700 0.94em/1.3 Pretendard, system-ui, sans-serif; }
  #lc-title { margin: 12px 0 0; font: 800 2.75em/1.4 Pretendard, system-ui, sans-serif; letter-spacing: -0.035em; color: #5a3737; max-width: 24em; text-wrap: pretty; }
  .lead-lg { margin: 22px 0 0; font: 400 1.32em/1.8 Pretendard, system-ui, sans-serif; color: var(--muted); max-width: 34em; text-wrap: pretty; }
  section[aria-labelledby='lc-title'] .btn { margin-top: 28px; font: 800 1.38em/1 Pretendard, system-ui, sans-serif !important; padding: 20px 36px; }

  #lc-kinds, #lc-tutors { margin: 0 0 24px; font: 800 1.88em/1.4 Pretendard, system-ui, sans-serif; color: #5a3737; }
  .lecture-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .lecture-card { padding: 28px 26px; border: 1px solid #e5bfbf; border-radius: 16px; background: #faf2f2; }
  .lecture-target { display: block; font: 700 0.88em/1 Pretendard, system-ui, sans-serif; color: #784949; margin-bottom: 10px; }
  .lecture-card h3 { margin: 0 0 10px; font: 800 1.44em/1.4 Pretendard, system-ui, sans-serif; color: #5a3737; text-wrap: pretty; }
  .lecture-desc { display: block; font: 400 1.06em/1.75 Pretendard, system-ui, sans-serif; color: var(--muted); margin-bottom: 14px; text-wrap: pretty; }
  .lecture-meta { display: block; font: 600 0.94em/1.5 Pretendard, system-ui, sans-serif; color: var(--muted); }

  .lab-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 40px; align-items: center; }
  .eyebrow-sm { margin: 0 0 10px; font: 700 0.94em/1 Pretendard, system-ui, sans-serif; color: #784949; }
  #lc-lab { margin: 0 0 16px; font: 800 2em/1.35 Pretendard, system-ui, sans-serif; color: #5a3737; }
  .lab-desc { margin: 0 0 18px; font: 400 1.19em/1.8 Pretendard, system-ui, sans-serif; color: var(--muted); max-width: 32em; text-wrap: pretty; }
  .standalone-link { display: inline-block; padding: 4px 0; font: 700 1.06em/1 Pretendard, system-ui, sans-serif; }
  .lab-figure { border: 2px dashed #f1dede; border-radius: 16px; background: #fff; min-height: 15em; display: flex; align-items: center; justify-content: center; text-align: center; font: 600 0.94em/1.6 Pretendard, system-ui, sans-serif; color: var(--muted); padding: 20px; }

  .lead-sm { margin: 0 0 24px; font: 400 1.06em/1.7 Pretendard, system-ui, sans-serif; color: var(--muted); }
  .tutor-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .tutor-card { border: 1px solid #e5bfbf; border-radius: 16px; background: #faf2f2; overflow: hidden; }
  .tutor-photo { height: 12.5em; border-bottom: 1px solid #e5bfbf; background: #fff; display: flex; align-items: center; justify-content: center; font: 600 0.88em/1.5 Pretendard, system-ui, sans-serif; color: var(--muted); }
  .tutor-body { padding: 24px 26px 28px; }
  .tutor-body h3 { margin: 0 0 6px; font: 800 1.38em/1.3 Pretendard, system-ui, sans-serif; color: #5a3737; }
  .tutor-role { display: block; font: 700 1em/1.4 Pretendard, system-ui, sans-serif; color: #784949; margin-bottom: 12px; }
  .tutor-bio { display: block; font: 400 1.06em/1.75 Pretendard, system-ui, sans-serif; color: var(--muted); text-wrap: pretty; }

  @media (max-width: 860px) { .lecture-grid, .tutor-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .lab-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .lecture-grid, .tutor-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
