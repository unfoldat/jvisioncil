---
// 2026-08-17 디자인 목업 반영 — 강의 안내.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 확정 스키마 결정 — 강사 프로필은 폴더형(가변 개수), 강의 목록·강사 프로필 카드 그리드에
// 연결. 목업의 3명은 전부 "강사명 자리" placeholder였고 실제 강사 데이터가 아니었으므로
// 그대로 옮기지 않는다(가짜 이름을 진짜 데이터처럼 CMS에 넣는 게 더 나쁘다고 판단) —
// 대신 등록된 강사가 없을 때 그 사실을 알리는 안내문으로 대체한다.
const instructors = await getCollection('instructors');

const lectures = [
  { target: '사업주 및 근로자', title: '직장 내 장애인 인식개선 교육', mandatory: true, desc: '한국장애인고용공단 지정 교육기관으로 누적 500회 이상의 교육 진행 경험을 갖추고 있습니다.', meta: '1시간' },
  { target: '영유아 및 초등학생', title: '유아·아동 장애인식개선 교육', mandatory: true, desc: '체험활동·인형극·애니메이션 시청 등으로 진행합니다. 강사양성과정을 수료한 강사진이 연령과 발달 특성에 맞춰 구성합니다.', meta: '40~60분' },
  { target: '청소년', title: '청소년 장애인식개선 교육', mandatory: true, desc: '학급 단위로 진행하며, 장애인 음악가의 연주·영화 장면 활용·토론·캠페인 활동 등으로 구성합니다. 강사양성과정을 수료한 강사진이 학교 문화와 요청에 맞게 구성합니다.', meta: '1차시' },
  { target: '공공기관 및 지역사회', title: '사회적 장애인식개선 교육', mandatory: true, desc: '스토리텔링·장애체험·장애감수성 교육 등 기관 요청에 따라 내용을 조정합니다. 한국장애인개발원 강사양성과정을 수료한 다양한 전문 강사진이 진행합니다.', meta: '1시간' },
  { target: '중년 및 노인', title: '실명예방 교육', mandatory: false, desc: '다양한 안질환과 일상생활 관리 방법, 시력 저하 시 이용할 수 있는 서비스를 안내하고 교육자료를 제공합니다. 전문지식을 갖춘 강사진이 100회 이상의 교육 경험을 보유하고 있습니다.', meta: '50분' },
];

// 2026-08-18 작업지시서 — 목업엔 없던 신규 섹션(명시 승인). 항목 3개 고정·개편 빈도
// 낮음(강사 프로필처럼 자주 늘고 주는 데이터가 아님)이라 CMS 컬렉션화하지 않고 정적
// 데이터로 둔다 — 나중에 항목이 늘거나 자주 바뀌면 강사 프로필과 같은 폴더형 컬렉션
// 패턴을 그대로 적용하면 된다.
const extraCourses = [
  { no: '01', title: '기타 중도실명 이해 교육', desc: '중도실명 이후의 심리·생활 변화와 필요한 지원을 이해하는 교육' },
  { no: '02', title: '활동지원사 양성교육', desc: '다양한 영역의 장애인의 특성과 효과적인 활동지원 방법을 다루는 실무 중심 교육' },
  { no: '03', title: '동료상담사 양성교육', desc: '장애 당사자의 경험을 상담 자원으로 활용하기 위한 기본 역량 교육' },
];

---

<BaseLayout pageName="강의 안내" bg="#F4E4E4">
  <section aria-labelledby="lc-title" class="intro">
    <div class="wrap">
      <p class="eyebrow"><span class="pill">강의 안내</span></p>
      <h1 id="lc-title">현장에서 바로 쓰이는 장애인식개선 교육</h1>
      <p class="lead-lg">한국장애인고용공단 직장 내 장애인 인식개선 교육 지정 수행기관이며, 한국장애인개발원 강사양성과정을 수료한 전문 강사진이 대상별 특성에 맞춰 교육을 진행합니다.</p>
      <a href="https://forms.gle/CaqAgMm5jQyH2bHR7" class="btn btn-lg">
        강의 신청하기 <span class="sr-only">, Google Forms로 이동</span>
      </a>
    </div>
  </section>

  <section aria-labelledby="lc-kinds" class="tint">
    <div class="wrap">
      <h2 id="lc-kinds">강의 종류</h2>
      <ul class="lecture-grid">
        {lectures.map((l) => (
          <li class="lecture-card">
            <span class="lecture-target">대상: {l.target}</span>{' '}
            {l.mandatory && <span class="lecture-badge">법정의무교육</span>}{' '}
            <h3>{l.title}</h3>{' '}
            <span class="lecture-desc">{l.desc}</span>{' '}
            <span class="lecture-meta">교육시간: {l.meta}</span>
          </li>
        ))}
      </ul>
      <p class="lecture-note">교육 문의 및 세부 구성은 기관 요청에 따라 협의 가능합니다.</p>
    </div>
  </section>

  <section aria-labelledby="lc-extra" class="tint">
    <div class="wrap">
      <h2 id="lc-extra">기타 전문교육</h2>
      <p class="lead-sm">기관의 목적과 참여자의 특성에 따라 교육 내용을 협의하여 구성합니다.</p>
      <ol class="extra-grid">
        {extraCourses.map((c) => (
          <li class="extra-card">
            <span aria-hidden="true" class="extra-no">{c.no}</span>{' '}
            <h3>{c.title}</h3>{' '}
            <span>{c.desc}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="lc-tutors" class="intro">
    <div class="wrap">
      <h2 id="lc-tutors">강사 프로필</h2>
      {instructors.length === 0 ? (
        <p class="lead-sm">아직 등록된 강사 프로필이 없습니다.</p>
      ) : (
        <ul class="tutor-grid">
          {instructors.map((t) => (
            <li class="tutor-card">
              <img class="tutor-photo" src={t.data.photo} alt={t.data.photoAlt ?? ''} style={`object-position:${t.data.photoPos || 'center 20%'}`} />
              <div class="tutor-body">
                <h3>{t.data.name}</h3>{' '}
                <span class="tutor-role">{t.data.role}</span>{' '}
                <ul class="tutor-bio" role="list" aria-label={`${t.data.name} 약력`}>
                  {t.data.bio.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .intro { background: #f4e4e4; padding: 62px 0 46px; }
  .tint { background: #faf2f2; padding: 58px 0; }
  .pill { display: inline-flex; padding: 6px 14px; border-radius: 999px; background: #c87a7a; color: #000; font: 700 0.94em/1.3 Pretendard, system-ui, sans-serif; }
  #lc-title { margin: 12px 0 0; font: 800 2.75em/1.4 Pretendard, system-ui, sans-serif; letter-spacing: -0.035em; color: #5a3737; max-width: 24em; text-wrap: pretty; }
  .lead-lg { margin: 22px 0 0; font: 400 1.32em/1.8 Pretendard, system-ui, sans-serif; color: var(--muted); max-width: 35em; text-wrap: pretty; }
  section[aria-labelledby='lc-title'] .btn { margin-top: 28px; font: 800 1.38em/1 Pretendard, system-ui, sans-serif !important; padding: 20px 36px; }

  #lc-kinds, #lc-extra, #lc-tutors { margin: 0 0 24px; font: 800 1.88em/1.4 Pretendard, system-ui, sans-serif; color: #5a3737; }
  .lecture-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .lecture-card { padding: 28px 26px; border: 1px solid #e5bfbf; border-radius: 16px; background: #faf2f2; display: flex; flex-direction: column; }
  .lecture-target { display: block; font: 700 0.88em/1 Pretendard, system-ui, sans-serif; color: #784949; margin-bottom: 10px; }
  .lecture-badge { display: inline-block; border-radius: 999px; font: 700 0.84em/1.4 Pretendard, system-ui, sans-serif; padding: 3px 10px; background: #f9eedd; color: #664c27; margin-bottom: 10px; }
  .lecture-card h3 { margin: 0 0 10px; font: 800 1.44em/1.4 Pretendard, system-ui, sans-serif; color: #5a3737; text-wrap: pretty; }
  .lecture-desc { display: block; font: 400 1.06em/1.75 Pretendard, system-ui, sans-serif; color: var(--muted); margin-bottom: 14px; text-wrap: pretty; }
  .lecture-meta { display: block; margin-top: auto; font: 600 0.94em/1.5 Pretendard, system-ui, sans-serif; color: var(--muted); }
  .lecture-note { margin: 22px 0 0; font: 400 0.88em/1.7 Pretendard, system-ui, sans-serif; color: var(--muted); }

  .extra-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .extra-card { display: flex; flex-direction: column; gap: 10px; padding: 28px 26px; border: 1px solid #e5bfbf; border-radius: 16px; background: #fff; }
  .extra-no { font: 700 0.94em/1 Pretendard, system-ui, sans-serif; color: #c87a7a; }
  .extra-card h3 { margin: 0; font: 800 1.25em/1.4 Pretendard, system-ui, sans-serif; color: #5a3737; text-wrap: pretty; }
  .extra-card span:not(.extra-no) { font: 400 1.06em/1.75 Pretendard, system-ui, sans-serif; color: var(--muted); text-wrap: pretty; }

  .lead-sm { margin: 0 0 24px; font: 400 1.06em/1.7 Pretendard, system-ui, sans-serif; color: var(--muted); }
  .tutor-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .tutor-card { border: 1px solid #e5bfbf; border-radius: 16px; background: #faf2f2; overflow: hidden; }
  .tutor-photo { width: 100%; height: 12.5em; border-bottom: 1px solid #e5bfbf; object-fit: contain; background: #faf2f2; display: block; }
  .tutor-body { padding: 24px 26px 28px; }
  .tutor-body h3 { margin: 0 0 6px; font: 800 1.38em/1.3 Pretendard, system-ui, sans-serif; color: #5a3737; }
  .tutor-role { display: block; font: 700 1em/1.4 Pretendard, system-ui, sans-serif; color: #784949; margin-bottom: 12px; }
  .tutor-bio { list-style: none; margin: 0; padding-left: 1.1em; display: grid; gap: 8px; }
  .tutor-bio li { position: relative; font: 400 1.06em/1.45 Pretendard, system-ui, sans-serif; color: var(--muted); text-wrap: pretty; }
  .tutor-bio li::before { content: ''; position: absolute; left: -1.1em; top: 0.62em; width: 5px; height: 5px; border-radius: 50%; background: #c87a7a; }

  @media (max-width: 860px) { .lecture-grid, .extra-grid, .tutor-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .lecture-grid, .extra-grid, .tutor-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
