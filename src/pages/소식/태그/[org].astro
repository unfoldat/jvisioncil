---
// 2026-08-17 디자인 목업 반영.
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NoticeList from '../../../components/NoticeList.astro';
import { sortForList, filterTargets, belongsToTarget } from '../../../lib/notices';

export async function getStaticPaths() {
  const notices = await getCollection('notices');
  const orgs = await getCollection('network-orgs');
  const targets = filterTargets(orgs);

  return targets.map((target) => ({
    params: { org: target.id },
    props: {
      orgName: target.name,
      notices: sortForList(notices.filter((n) => belongsToTarget(n, target.id))),
    },
  }));
}

const { orgName, notices } = Astro.props;
---

<BaseLayout pageName={`${orgName} 소식`}>
  <section aria-labelledby="nw-title" class="intro">
    <div class="wrap">
      <p class="eyebrow"><span class="pill">소식</span></p>
      <h1 id="nw-title">{orgName} 소식</h1>
      <p><a href="/소식/">소식 전체 목록</a></p>
    </div>
  </section>
  <section class="tint">
    <div class="wrap">
      <NoticeList notices={notices} variant="board" empty={`${orgName} 소식은 아직 없습니다.`} />
    </div>
  </section>
</BaseLayout>

<style>
  .intro { background: #ede8ee; padding: 62px 0 34px; }
  .pill { display: inline-flex; padding: 6px 14px; border-radius: 999px; background: #8e7193; color: #000; font: 700 0.94em/1.3 Pretendard, system-ui, sans-serif; }
  #nw-title { margin: 12px 0; font: 800 2.75em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #403342; }
  .tint { background: #f6f4f6; border-top: 1px solid #d0c3d2; padding: 58px 0 66px; }
</style>
