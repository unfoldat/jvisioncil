---
// 2026-08-17 디자인 목업 반영 — 데스크톱·모바일 공통 카드 그리드(NoticeList).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoticeList from '../../components/NoticeList.astro';
import { sortForList, 태그경로, filterTargets } from '../../lib/notices';

const notices = sortForList(await getCollection('notices'));
const orgs = (await getCollection('network-orgs')).sort((a, b) => a.id.localeCompare(b.id));
const filterOrgs = filterTargets(orgs);

// 활동 사진 — 페이지마다 독립된 배열(나중에 다른 사진으로 바꾸기 쉽게 공유 lib로 묶지 않음).
const PHOTOS = [
  { src: '/images/gallery/01.jpg', alt: '정기총회 현장, 발표자가 마이크를 들고 인사말을 하는 모습과 박수치는 참석자들' },
  { src: '/images/gallery/02.jpg', alt: '도자기 교실에서 참가자가 흙을 빚는 손 클로즈업' },
  { src: '/images/gallery/03.jpg', alt: '실내 강연장에서 발표자가 스크린 앞에서 이야기하는 모습' },
  { src: '/images/gallery/04.jpg', alt: '붉은 흙길 산행로를 걷는 참가자들, 흰지팡이를 든 참가자 포함' },
  { src: '/images/gallery/05.jpg', alt: '두 사람이 협약서를 나란히 들고 있는 모습, 뒤로 음악회 포스터' },
  { src: '/images/gallery/06.jpg', alt: '점자책을 손으로 짚어 읽는 시각장애인과 옆에서 함께 짚어주는 담당자, 흰지팡이가 탁자 위에 놓여 있음' },
  { src: '/images/gallery/07.jpg', alt: '한궁 과녁과 사진 전시가 있는 실내 공간에서 참가자들이 대화하는 모습' },
  { src: '/images/gallery/08.jpg', alt: '한옥 앞 단체사진, "좋은비전과 함께하는 봄,여름,가을,겨울 후원 앤시스코리아" 현수막을 흰지팡이를 든 참가자가 들고 있음' },
  { src: '/images/gallery/09.jpg', alt: '두 사람이 장학증서를 함께 들고 있는 모습' },
  { src: '/images/gallery/10.jpg', alt: '서울필로스합창단 단원들이 무대에서 합창하는 모습' },
  { src: '/images/gallery/11.jpg', alt: '녹음 부스에서 여러 명이 원고를 들고 마이크 앞에 서 있는 모습(낭독 녹음)' },
];
const galleryLoop = PHOTOS.concat(PHOTOS);
---

<BaseLayout pageName="소식">
  <section aria-labelledby="nw-title" class="intro">
    <div class="wrap">
      <p class="eyebrow"><span class="pill">소식</span></p>
      <h1 id="nw-title">좋은비전의 활동을 전합니다</h1>
    </div>
  </section>

  <section aria-label="활동 사진" class="gallery-band">
    <div class="marquee">
      <div class="marquee-track">
        {galleryLoop.map((photo, i) => (
          <img class="marquee-item" src={photo.src} alt={i >= PHOTOS.length ? '' : photo.alt} aria-hidden={i >= PHOTOS.length ? 'true' : undefined} loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="nw-board" class="tint">
    <div class="wrap">
      <h2 id="nw-board">전체 소식</h2>
      {filterOrgs.length > 0 && (
        <nav aria-label="소식 기관 분류" class="tabs-nav">
          <ul class="tabs">
            <li><a href="/소식/" aria-current="page">전체</a></li>
            {filterOrgs.map((org) => (
              <li><a href={태그경로(org.id)}>{org.name}</a></li>
            ))}
          </ul>
        </nav>
      )}
      <NoticeList notices={notices} empty="아직 소식이 없습니다." />
    </div>
  </section>
</BaseLayout>

<style>
  .intro { background: #ede8ee; padding: 62px 0 34px; }
  .pill { display: inline-flex; padding: 6px 14px; border-radius: 999px; background: #8e7193; color: #000; font: 700 0.94em/1.3 Pretendard, system-ui, sans-serif; }
  #nw-title { margin: 12px 0 0; font: 800 2.75em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #403342; }
  .tint { background: #f6f4f6; border-top: 1px solid #d0c3d2; padding: 58px 0 66px; }
  #nw-board { margin: 0 0 26px; font: 800 1.88em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #403342; }
  .tabs { flex-wrap: wrap; gap: 8px; padding: 0; margin: 0 0 26px; list-style: none; display: flex; }
  .tabs a {
    border: 1px solid #d0c3d2; background: #fff; align-items: center; min-height: 2.5rem;
    padding: 10px 16px; display: inline-flex; text-decoration: none; color: var(--ink);
    border-radius: 999px; font: 600 0.94em/1 Pretendard, system-ui, sans-serif;
  }
  .tabs a[aria-current='page'] { background: #403342; color: #fff; border-color: #403342; font-weight: 800; }

  .gallery-band { padding: 0 0 42px; background: #ede8ee; }
  .marquee { overflow: hidden; }
  .marquee-track { display: flex; gap: 16px; width: max-content; animation: marquee 120s linear infinite; }
  .marquee:hover .marquee-track, .marquee:focus-within .marquee-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .marquee-item { width: 16.5em; height: 10.8em; flex: none; border-radius: 14px; background: #fff; object-fit: cover; display: block; }
</style>
