---
// 2026-08-17 디자인 목업 반영 — 데스크톱·모바일 공통 카드 그리드(NoticeList).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoticeList from '../../components/NoticeList.astro';
import { sortForList, PAGE_SIZE, totalPages } from '../../lib/notices';

const allNotices = sortForList(await getCollection('notices'));
const pageNotices = allNotices.slice(0, PAGE_SIZE);
const pages = totalPages(allNotices.length);

// 활동 사진 — 확정 스키마 결정: 소식과 분리된 공유 gallery 컬렉션, "노출 위치"
// 체크박스로 페이지별 필터링(지금은 3곳 다 같은 사진이라 필터 결과도 동일).
const PHOTOS = (await getCollection('gallery'))
  .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))
  .filter((entry) => entry.data.showOn.includes('news'))
  .map((entry) => ({ src: entry.data.photo, alt: entry.data.alt ?? '' }));
const galleryLoop = PHOTOS.concat(PHOTOS);
---

<BaseLayout pageName="소식" bg="#EDE8EE">
  <section aria-labelledby="nw-title" class="intro">
    <div class="wrap">
      <p class="eyebrow"><span class="pill">소식</span></p>
      <h1 id="nw-title">좋은비전의 활동을 전합니다</h1>
    </div>
  </section>

  <section aria-labelledby="nw-gallery" class="gallery-band">
    <h2 id="nw-gallery" class="wrap">활동 사진</h2>
    <div class="marquee">
      <div class="marquee-track">
        {galleryLoop.map((photo, i) => (
          <img class="marquee-item" src={photo.src} alt={i >= PHOTOS.length ? '' : photo.alt} aria-hidden={i >= PHOTOS.length ? 'true' : undefined} loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="nw-board" class="tint">
    <div class="wrap">
      <h2 id="nw-board">전체 소식</h2>
      <NoticeList notices={pageNotices} empty="아직 소식이 없습니다." currentPage={1} totalPages={pages} />
    </div>
  </section>
</BaseLayout>

<style>
  .intro { background: #ede8ee; padding: 62px 0 34px; }
  .pill { display: inline-flex; padding: 6px 14px; border-radius: 999px; background: #8e7193; color: #000; font: 700 0.94em/1.3 Pretendard, system-ui, sans-serif; }
  #nw-title { margin: 12px 0 0; font: 800 2.75em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #403342; }
  .tint { background: #f6f4f6; border-top: 1px solid #d0c3d2; padding: 58px 0 66px; }
  #nw-board { margin: 0 0 26px; font: 800 1.88em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #403342; }

  .gallery-band { padding: 34px 0 42px; background: #ede8ee; }
  /* h2 자체가 .wrap(마퀴는 화면 끝까지 퍼져야 해서 h2만 wrap) — margin shorthand로
     top/bottom만 정하면 안 된다(3값이 left/right도 0으로 덮어써 .wrap의 margin:auto
     가운데 정렬이 깨짐, index.astro의 #home-gallery와 동일 이유). */
  #nw-gallery { margin-top: 0; margin-bottom: 22px; font: 800 1.7em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #403342; }
  .marquee { overflow: hidden; }
  .marquee-track { display: flex; gap: 16px; width: max-content; animation: marquee 120s linear infinite; }
  .marquee:hover .marquee-track, .marquee:focus-within .marquee-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .marquee-item { width: 11.8em; height: 7.7em; flex: none; border-radius: 14px; background: #fff; object-fit: cover; display: block; }
</style>
