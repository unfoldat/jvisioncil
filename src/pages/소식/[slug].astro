---
// url 없는 글 = 우리가 원본(활동소식) → 내부 상세. 2026-08-17 디자인 목업 반영.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { noticeOrgDisplay } from '../../lib/notices';
import { orgMap } from '../../lib/networkOrgs';

export async function getStaticPaths() {
  const allNotices = await getCollection('notices');
  const internalNotices = allNotices.filter(({ data }) => !data.url);
  return internalNotices.map((notice) => ({ params: { slug: notice.id }, props: { notice } }));
}

const { notice } = Astro.props;
const { Content } = await render(notice);
const { name: orgName, url: orgUrl } = noticeOrgDisplay(notice, await orgMap());
const isoDate = notice.data.date.toISOString().slice(0, 10);
---

<BaseLayout pageName={notice.data.title}>
  <article>
    <section class="post-head">
      <div class="wrap">
        {orgUrl ? (
          <a class="tag" href={orgUrl} target="_blank" rel="noopener noreferrer">{orgName}<span class="sr-only">, 공식 사이트, 새 창에서 열림</span></a>
        ) : (
          <span class="tag">{orgName}</span>
        )}
        <h1>{notice.data.title}</h1>
        <p class="post-meta">{orgName} · <time datetime={isoDate} data-pagefind-meta="date[datetime]">{isoDate}</time></p>
      </div>
    </section>
    <section class="post-body">
      <div class="wrap">
        <Content />
        <p><a href="/소식/">소식 목록으로 돌아가기</a></p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .post-head { background: #ede8ee; border-bottom: 1px solid #d0c3d2; padding: 62px 0 34px; }
  .tag { display: inline-block; border-radius: 999px; background: #f3eed9; color: #5c5640; text-decoration: none; font: 700 0.84em/1.4 Pretendard, system-ui, sans-serif; padding: 3px 10px; margin-bottom: 12px; }
  .post-head h1 { margin: 0; font: 800 2.5em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #403342; }
  .post-meta { margin: 14px 0 0; color: var(--muted); }
  .post-body { padding: 44px 0 66px; }
  .post-body :global(p) { max-width: 44em; font: 400 1.13em/1.85 Pretendard, system-ui, sans-serif; color: var(--muted); }
</style>
