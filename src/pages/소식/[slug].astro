---
// 소식 = 좋은비전 단독 게시판(확정 결정) — 전부 내부 상세. 2026-08-17 디자인 목업 반영.
// 2026-08-19 작업지시서 — 별도 대표 사진(image/imageAlt) 필드 폐지. 본문(body)의 첫 번째
// 마크다운 이미지를 대표 이미지로 재사용하고, 본문(rendered.html)에서는 그 첫 이미지를
// 지워서 같은 사진이 대표 이미지·본문에 두 번 뜨지 않게 한다. entry.rendered.html은
// Astro 콘텐츠 레이어가 astro.config.mjs의 markdown 파이프라인(rehype-sanitize 포함)으로
// 이미 컴파일·새니타이즈해 둔 HTML이라 — render()/<Content/>를 쓰지 않고 이 문자열을
// 그대로 가져와 이미지 부분만 문자열 단위로 수술한다(마크다운을 직접 재파싱하지 않음).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { firstBodyImage, stripFirstImage, tagPortraitImages, linkifyImages } from '../../lib/noticeImage';

export async function getStaticPaths() {
  const notices = await getCollection('notices');
  return notices.map((notice) => ({ params: { slug: notice.id }, props: { notice } }));
}

const { notice } = Astro.props;
const isoDate = notice.data.date.toISOString().slice(0, 10);
const heroImage = firstBodyImage(notice.body);
const bodySource = heroImage ? stripFirstImage(notice.rendered?.html) : (notice.rendered?.html ?? '');
const bodyHtml = linkifyImages(tagPortraitImages(bodySource));
---

<BaseLayout pageName={notice.data.title} bg="#EDE8EE">
  <article>
    <section class="post-head">
      <div class="wrap">
        <h1>{notice.data.title}</h1>
        <p class="post-meta"><time datetime={isoDate} data-pagefind-meta="date[datetime]">{isoDate}</time></p>
      </div>
    </section>
    {heroImage && (
      <section class="post-photo">
        <div class="wrap">
          <a class="post-photo-link" href={heroImage.src} target="_blank" rel="noopener">
            <span class="sr-only">원본 크기로 보기</span>
            <span class="post-photo-box">
              <img class="post-photo-img" src={heroImage.src} alt={heroImage.alt} />
            </span>
          </a>
        </div>
      </section>
    )}
    <section class="post-body">
      <div class="wrap">
        <Fragment set:html={bodyHtml} />
        <p><a href="/소식/">소식 목록으로 돌아가기</a></p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .post-head { background: #ede8ee; border-bottom: 1px solid #d0c3d2; padding: 62px 0 34px; }
  .post-head h1 { margin: 0; font: 800 2.5em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #403342; }
  .post-meta { margin: 14px 0 0; color: var(--muted); }
  .post-photo { padding: 34px 0 0; }
  .post-photo-link { display: block; }
  .post-photo-box { display: flex; align-items: center; justify-content: center; height: 22em; border: 1px solid #d0c3d2; border-radius: 16px; background: #fff; overflow: hidden; }
  .post-photo-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-body { padding: 44px 0 66px; }
  .post-body :global(p) { max-width: 44em; font: 400 1.13em/1.85 Pretendard, system-ui, sans-serif; color: var(--muted); }
  /* 본문(마크다운) 삽입 사진 — 가로 사진뿐 아니라 포스터 같은 세로 사진도 다뤄야 해서
     object-fit으로 자르지 않고 원본 비율 그대로 둔다. width:100%를 쓰면 원본이 본문
     컬럼(.post-body :global(p)의 max-width:44em)보다 작을 때도 억지로 늘어나므로
     width:auto로 실제 크기를 우선하고, max-width만으로 큰 사진을 줄인다(p 태그 안에
     감싸져 렌더링되므로 max-width:100%가 이미 그 p의 44em 컬럼 폭 안에서 계산된다 —
     44em을 여기 다시 안 적어도 됨). margin: auto로 가운데 정렬. */
  .post-body :global(img) { display: block; max-width: 100%; width: auto; height: auto; margin: 24px auto; border-radius: 12px; }
  /* 세로(포스터형) 사진만 표시 폭을 좁혀 본문 흐름에 자연스럽게 — max-height로 자르지
     않는다(정보 손실 없이 전체를 다 보여줘야 함). 빌드 타임 실측 판별, JS 없음
     (src/lib/imageOrientation.ts). */
  .post-body :global(img.post-img-portrait) { max-width: 600px; }
  .post-body :global(a.post-img-link) { display: block; }
</style>
