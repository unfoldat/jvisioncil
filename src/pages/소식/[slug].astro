---
// 소식 = 좋은비전 단독 게시판(확정 결정) — 전부 내부 상세. 2026-08-17 디자인 목업 반영.
// 2026-08-19 작업지시서 — 별도 "대표 이미지"(상단 가로 배너) 개념 자체를 없앤다. 본문에
// 첨부한 사진은 본문 흐름 안에서만 보여준다(균일한 크기 규칙은 유지, 아래 CSS 참고).
// 2026-08-19(음성 탐색 검증) — 본문 이미지를 <a target="_blank">로 감싸 "원본 크기로
// 보기"를 제공하던 기능을 제거했다. 실기에서 이 링크가 이미지 alt를 덮어써 스크린리더가
// 사진 설명을 제대로 못 읽는 정황이 있었고(원인 미확정), 새 탭 이동도 현재 탐색 맥락을
// 깨뜨렸다 — 지금은 필요하지 않은 기능이라 <img>만 그대로 둔다.
// entry.rendered.html은 Astro 콘텐츠 레이어가 astro.config.mjs의 markdown 파이프라인
// (rehype-sanitize 포함)으로 이미 컴파일·새니타이즈해 둔 HTML이라 — render()/<Content/>를
// 쓰지 않고 이 문자열을 그대로 가져와 이미지 태그만 문자열 단위로 보강한다(세로 사진
// 표시폭 제한 클래스 부여만 — 마크다운을 재파싱하지 않음).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagPortraitImages, stripImageTitle } from '../../lib/noticeImage';

export async function getStaticPaths() {
  const notices = await getCollection('notices');
  return notices.map((notice) => ({ params: { slug: notice.id }, props: { notice } }));
}

const { notice } = Astro.props;
const isoDate = notice.data.date.toISOString().slice(0, 10);
const bodyHtml = tagPortraitImages(stripImageTitle(notice.rendered?.html ?? ''));
---

<BaseLayout pageName={notice.data.title} bg="#EDE8EE">
  <article>
    <section class="post-head">
      <div class="wrap">
        <h1>{notice.data.title}</h1>
        <p class="post-meta"><time datetime={isoDate} data-pagefind-meta="date[datetime]"><span class="sr-only">작성일 </span>{isoDate}</time></p>
      </div>
    </section>
    <section class="post-body">
      <div class="wrap">
        <!-- 2026-08-20(헤딩 지도 최소 보강) — 글이 짧아 글쓴이가 소제목(##)을 안 썼어도
             H 탐색으로 "본문 시작"까지는 반드시 도달하게 하는 sr-only 헤딩. 시각 디자인
             변화 없음(.sr-only 재사용, 새 CSS 없음). 화살표 탐색에서도 "본문" 한 단어만
             추가로 지나가는 정도라 장황한 안내문이 아님 — 원칙(가짜 헤딩 금지)과 구분:
             이 구역은 실제로 헤딩이 필요한 콘텐츠 전환점(제목 구역 → 본문 구역)이라
             "가짜"가 아니라 정당한 헤딩이다. 글쓴이가 본문에 ## 소제목을 쓰면 이 H2
             다음에 이어서 H2/H3로 잡힌다(마크다운 헤딩 변환은 별도로 실측 확인됨). -->
        <h2 class="sr-only">본문</h2>
        <Fragment set:html={bodyHtml} />
        <p><a href="/소식/">소식 목록으로 돌아가기</a></p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .post-head { background: #ede8ee; border-bottom: 1px solid #d0c3d2; padding: 62px 0 34px; }
  .post-head h1 { margin: 0; font: 800 2.5em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #403342; }
  .post-meta { margin: 14px 0 0; color: var(--muted); }
  .post-body { padding: 44px 0 66px; }
  .post-body :global(p) { max-width: 44em; font: 400 1.13em/1.85 Pretendard, system-ui, sans-serif; color: var(--muted); }
  /* 본문(마크다운) 삽입 사진 — 가로 사진뿐 아니라 포스터 같은 세로 사진도 다뤄야 해서
     object-fit으로 자르지 않고 원본 비율 그대로 둔다. width:100%를 쓰면 원본이 본문
     컬럼(.post-body :global(p)의 max-width:44em)보다 작을 때도 억지로 늘어나므로
     width:auto로 실제 크기를 우선하고, max-width만으로 큰 사진을 줄인다(p 태그 안에
     감싸져 렌더링되므로 max-width:100%가 이미 그 p의 44em 컬럼 폭 안에서 계산된다 —
     44em을 여기 다시 안 적어도 됨). margin: auto로 가운데 정렬. "균일하게 보인다"는
     전부 같은 크기가 아니라 이 폭 범위 안에서 너무 크거나 작지 않게 일관되게 보인다는 뜻. */
  .post-body :global(img) { display: block; max-width: 100%; width: auto; height: auto; margin: 24px auto; border-radius: 12px; }
  /* 세로(포스터형) 사진만 표시 폭을 좁혀 본문 흐름에 자연스럽게 — max-height로 자르지
     않는다(정보 손실 없이 전체를 다 보여줘야 함). 빌드 타임 실측 판별, JS 없음
     (src/lib/imageOrientation.ts). */
  /* min()으로 감싸지 않으면 600px가 위 규칙의 max-width:100%를 완전히 덮어써서
     좁은 화면(예: 375px 모바일)에서 컨테이너 폭을 무시하고 가로 스크롤이 생긴다
     (실측으로 발견 — 488px 세로 사진이 375px 화면에서 그대로 넘침). */
  .post-body :global(img.post-img-portrait) { max-width: min(600px, 100%); }
</style>
