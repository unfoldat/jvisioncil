---
// 2026-08-17 디자인 목업 반영 — 센터소개(URL은 /기관소개/ 유지, 표시 라벨만 "센터소개").
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 확정 스키마 결정 — 센터장·부센터장은 파일형(고정 2명). getCollection의 파일시스템
// 순회 순서에 기대지 않고 id를 직접 지정해 "센터장 → 부센터장" 순서를 코드로 보장한다.
const director = await getEntry('leadership', 'director');
const deputyDirector = await getEntry('leadership', 'deputy-director');
const leaders = [director, deputyDirector];

const orgInfo = await getEntry('org-info', 'info');

const mainPrograms = [
  { no: '01', name: '중도실명인을 위한 컨설팅', desc: '질병이나 사고 등으로 후천적으로 시력을 잃은 중도실명인이 변화된 생활환경에 적응하고 새로운 삶을 준비할 수 있도록 재활 컨설팅을 제공합니다. 개인의 상황과 필요에 따라 복지서비스, 교육, 직업, 여가 및 일상생활 적응에 필요한 정보와 지원 방향을 안내합니다.' },
  { no: '02', name: '시각장애인 심리평가 및 상담', desc: '시각장애로 인해 경험할 수 있는 심리적 어려움과 정서적 스트레스를 이해하고 지원하기 위해 전문적인 심리평가와 그에 근거한 상담을 제공합니다.' },
  { no: '03', name: '청소년 시각장애인을 위한 진로 및 심리상담', desc: '통합학급, 특수학급 및 특수학교에 재학 중인 시각장애 청소년을 대상으로 흥미, 강점, 적성 및 진로 탐색을 위한 전문적인 심리 및 직업 진로 평가와 상담을 제공합니다.' },
  { no: '04', name: '직장 내 장애인 인식개선 교육', desc: '한국장애인고용공단의 직장 내 장애인 인식개선 교육 지정 수행기관으로, 사업주와 근로자를 대상으로 법정의무교육인 직장 내 장애인 인식개선 교육을 실시합니다.' },
  { no: '05', name: '사회적 장애인식개선 교육', desc: '한국장애인개발원의 사회적 장애인식개선교육 강사양성과정을 수료한 전문 강사진이 유아·청소년·공공기관·지역사회 등 대상별 특성을 고려한 장애인식개선 교육을 제공합니다.' },
  { no: '06', name: '「낭독하는 사람들」 낭독도서 제작 및 배포', desc: '시각장애인의 정보 접근과 독서문화 향유를 지원하기 위해 다양하게 읽을 컨텐츠들과 도서를 음성도서로 제작하여 배포합니다. 또한 시각장애인의 요청에 의해 듣기 원하는 글이나 책을 신청하면 오디오 녹음을 하여 파일로 제작해 드립니다.' },
];

const specialPrograms = [
  { name: '"우리두리 모두누리": 장애·비장애인 통합 소모임 활동', sponsor: '서울스몰스파크, 서울복지재단' },
  { name: '시각장애인 청소년과 시각장애인가정의 비장애인 청소년 영어 교류 캠프', sponsor: '좋은비전 자체사업' },
  { name: '결혼, 출산, 양육 스트레스를 경험하는 시각장애인 여성 집단상담', sponsor: '성주재단' },
  { name: '시각장애인 공무원 응시생 영어 공부방', sponsor: '사회복지공동모금회' },
  { name: '시각장애인 유튜버 발굴 및 제작 사업', sponsor: '한국장애인재단' },
  { name: '시각장애인과 함께 하는 "봄, 여름, 가을, 겨울": 계절별 트레킹·과일따기·음악회 등 문화 공연 행사', sponsor: '앤시스코리아' },
  { name: '시각장애 직장인을 위한 이브닝 도자기 교실', sponsor: '우리들의 눈' },
  { name: '시각장애인 아동을 위한 낭독 및 북나레이터 체험', sponsor: '낭독하는 사람들' },
];

const labFields = [
  { no: '01', name: '재활상담 및 프로그램 개발 연구', desc: '장애인의 심리적 적응과 자립, 사회참여를 지원하기 위한 재활상담 프로그램을 개발하고, 상담 및 재활서비스의 효과성을 체계적으로 분석합니다.' },
  { no: '02', name: '시각장애인의 고용 및 직업만족도 연구', desc: '시각장애인 안마사, 공무원, 교사, 음악인 등 다양한 직업군에 종사하는 시각장애인의 직업경험과 직업만족도, 직무환경, 직업유지 요인 및 삶의 질을 연구합니다.' },
  { no: '03', name: '장애인 접근성 연구', desc: '이동·정보·교육·문화·디지털 환경 등 장애인의 일상생활과 사회참여에 영향을 미치는 다양한 영역의 접근성을 조사하고, 장애인의 관점에서 보다 포용적인 환경을 만들기 위한 개선방안을 모색합니다.' },
  { no: '04', name: '방송·미디어와 장애인 인식 연구', desc: 'TV, 방송, 뉴스, 광고, 온라인 콘텐츠 등 미디어에서 장애인이 어떻게 표현되고 있는지를 분석하고, 장애에 대한 편견이나 고정관념, 차별적 표현 및 사례를 연구합니다. 이를 바탕으로 장애를 보다 존중하고 균형 있게 바라볼 수 있는 미디어 환경과 사회적 인식 개선 방안을 제안합니다.' },
  { no: '05', name: '장애인 삶의 질 및 사회환경 연구', desc: '장애인의 심리적 안녕, 가족관계, 사회적 관계, 여가, 문화생활, 지역사회 참여 등 삶의 다양한 영역을 연구하고, 장애인의 삶의 질을 높이기 위한 지원체계와 사회환경 개선방안을 모색합니다.' },
];

const busStops = [
  { name: '영락중학교입구 정류장', walk: '3분', routes: ['7019', '7734'] },
  { name: '신진과학기술고등학교 정류장', walk: '5분', routes: ['761', '7025'] },
];
---

<BaseLayout pageName="센터소개" bg="#F9EEDD">
  <section aria-labelledby="about-title" class="intro">
    <div class="wrap">
      <p class="eyebrow"><span class="pill">센터소개</span></p>
      <h1 id="about-title">"보는 방법은 달라도, <br />꿈을 바라보는 마음은 같습니다"</h1>
      <div class="intro-body">
        <p>좋은비전장애인자립생활센터는 시각장애인과 특히 중도실명인이 실명 이후에도 자신의 삶을 스스로 선택하고 결정하며, 지역사회의 한 구성원으로 함께 살아갈 수 있도록 지원하는 센터입니다.</p>
        <p>갑작스러운 실명으로 새로운 삶에 적응해야 하는 중도시각장애인부터 지역사회에서 자신의 꿈을 펼쳐가는 한 사람 한 사람의 시각장애인의 삶과 가능성을 존중합니다. 우리가 생각하는 '좋은비전'은 단순히 눈으로 보는 것이 아닙니다. 자신의 미래를 바라보는 것, 새로운 가능성을 발견하는 것, 그리고 서로 다른 사람들이 지역사회에서 함께 살아가는 세상을 꿈꾸는 것입니다.</p>
        <p class="intro-emph">장애가 삶의 한계가 되지 않는 사회, 장애인과 비장애인이 자연스럽게 함께 살아가는 지역사회. <br />좋은비전장애인자립생활센터가 그 길을 함께 만들어가겠습니다.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="about-people" class="panel">
    <div class="wrap">
      <h2 id="about-people">센터장 · 부센터장 소개</h2>
      <ul class="leader-grid">
        {leaders.map((ld) => (
          <li class="leader-card">
            <div class="leader-profile">
              <img class="leader-photo" src={ld.data.photo} alt={ld.data.photoAlt ?? ''} style={`object-position:${ld.data.photoPos || 'center 20%'}`} />
              <div class="leader-info">
                <h3>
                  <span class="leader-role">{ld.data.role}</span>{' '}
                  <span class="leader-name">{ld.data.name}</span>
                </h3>
                <ul class="leader-bio" role="list" aria-label={`${ld.data.name} ${ld.data.role} 주요 약력`}>
                  {ld.data.bio.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="about-main" class="panel">
    <div class="wrap">
      <h2 id="about-main">주요사업</h2>
      <ol class="program-grid">
        {mainPrograms.map((pg) => (
          <li class="program-card">
            <div class="program-head"><span aria-hidden="true" class="program-no">{pg.no}</span>{' '}<h3>{pg.name}</h3></div>
            {' '}<span>{pg.desc}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="about-special" class="tint">
    <div class="wrap">
      <h2 id="about-special">특화 사업</h2>
      <p class="lead-sm">후원 기관과 함께 진행하는 사업입니다.</p>
      <div class="table-scroll">
        <table class="special-table">
          <caption>사업 내용과 후원 기관</caption>
          <thead>
            <tr><th scope="col">사업 내용</th><th scope="col">후원 기관</th></tr>
          </thead>
          <tbody>
            {specialPrograms.map((sp) => (
              <tr><td>{sp.name}</td><td>{sp.sponsor}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section aria-labelledby="about-lab" class="panel">
    <div class="wrap">
      <p class="eyebrow-sm">부설기관</p>
      <h2 id="about-lab">좋은비전재활상담연구소</h2>
      <div class="lab-body">
        <p>좋은비전재활상담연구소는 상담과 연구가 장애인의 삶과 재활 현장에서 실질적인 변화로 이어질 수 있도록 장애인의 삶을 가까이에서 이해하고, 개인이 지닌 강점과 가능성을 발견하며, 더 나은 삶의 방향을 함께 모색하는 전문 상담·연구기관입니다.</p>
        <p>장애와 재활을 개인의 문제에만 국한하지 않고 심리·직업·교육·문화·사회환경을 포괄하는 관점에서 바라보며, 현장에서 발견되는 다양한 문제와 요구를 체계적으로 연구하고 그 결과를 상담과 재활서비스, 프로그램 개발 및 장애인 정책과 실천에 활용하고자 합니다.</p>
        <p>좋은비전재활상담연구소는 '현장에서 질문을 발견하고, 연구를 통해 근거를 만들며, 그 결과를 다시 현장으로 돌려보내는 연구'를 지향합니다. 장애인의 실제 경험과 목소리를 연구의 출발점으로 삼아 상담과 재활, 교육과 직업, 문화와 사회환경의 변화를 만들어가는 실천적인 연구를 이어가겠습니다.</p>
      </div>
      <h3 class="lab-fields-title">주요 연구 분야</h3>
      <ol class="program-grid">
        {labFields.map((lf) => (
          <li class="program-card">
            <div class="program-head"><span aria-hidden="true" class="program-no">{lf.no}</span>{' '}<span class="program-title">{lf.name}</span></div>
            {' '}<span>{lf.desc}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="about-way" class="tint">
    <div class="wrap">
      <h2 id="about-way">오시는 길</h2>
      <div class="way-grid">
        <div class="way-card">
          <h3 class="way-label">주소</h3>
          <p class="way-address">{orgInfo.data.address}</p>
          <div class="way-map-wrap">
            <div id="daumRoughmapContainer1785386858595" class="root_daum_roughmap root_daum_roughmap_landing"></div>
          </div>
          <script is:inline src="https://ssl.daumcdn.net/dmaps/map_js_init/roughmapLoader.js"></script>
          <script is:inline>
            // 목업 원본의 Daum(카카오) 로드맵 위젯 그대로 이식 — timestamp/key는 이 주소
            // (응암로34길 24-8)로 만들어 둔 지도를 가리키는 고정 식별자라 그대로 재사용
            // 가능하다(세션 토큰 아님). roughmapLoader.js가 document.write로 실제 지도
            // 스크립트(roughmapLander.js)를 끼워 넣는 구조라 — 파싱 중인 위치에 그대로
            // 박혀 있는 일반 <script>(is:inline, 동적 주입 아님)여야 document.write가
            // 막히지 않는다. 그래서 Lander는 바로 다음 줄에서 곧장 써도 이미 준비돼 있다.
            new daum.roughmap.Lander({
              timestamp: '1785386858595',
              key: 'rptu8kud37r',
              mapWidth: '640',
              mapHeight: '360',
            }).render();
            // 지도와 조작 버튼만 남기고, 위젯 자체 주소·전화 표시는 숨긴다(옆 카드와 중복).
            setTimeout(() => {
              const el = document.getElementById('daumRoughmapContainer1785386858595');
              const root = el.classList.contains('root_daum_roughmap') ? el : el.querySelector('.root_daum_roughmap') || el;
              Array.prototype.forEach.call(root.children, (child) => {
                const c = child.className || '';
                const keep = /wrap_map|wrap_controllers|map_border|border_map/.test(c) || child.querySelector('img[src*="map"], canvas, iframe');
                if (!keep) child.style.display = 'none';
              });
            }, 900);
            // 2026-08-19 — 위젯이 카드 폭(약 537px)보다 넓어(640px) 가로 스크롤이 생기던 문제.
            // 위젯 자체 크기(mapWidth/mapHeight)는 그대로 두고 — 실측 결과 위젯의 실제 전체
            // 높이는 mapHeight 파라미터(360)가 아니라 392px다(로드뷰·길찾기 컨트롤 줄이 지도
            // 캔버스 아래 별도로 붙어서 32px 더 있음) — 이 실측값을 기준으로 wrapper 폭에 맞춰
            // transform:scale로 위젯 전체(컨트롤 포함)를 통째로 축소한다. 스케일은 하나의
            // 사각형 전체에 적용되므로 내부 절대좌표 컨트롤도 함께 정확히 축소된다 — 이전에
            // mapHeight=360 기준으로 wrapper 높이를 293px로 assumed 계산했을 때 컨트롤 줄이
            // 그 아래 32px 지점에 있어 잘려나갔던 것이지, scale 자체의 결함이 아니었다.
            let roughmapLastWidth = -1;
            // 2026-08-23 — 위젯(카카오 스크립트)이 아직 자기 내부 렌더를 안 끝낸 시점에
            // fitRoughmap이 먼저 실행되면 .way-map-wrap의 폭이 일시적으로 몇 px(레이아웃
            // 확정 전 과도 상태)로 잡히고, 그 비정상적인 값이 roughmapLastWidth에 그대로
            // 고정돼 버린다 — 이후 실제 폭(카드 기준 약 537px)으로 정상화돼도 "<1px 변화면
            // 재계산 안 함" 가드 때문에 영원히 그 비정상 scale에 갇힌다(실측: scale이
            // 0.003까지 떨어져 지도와 확대/축소 버튼이 전부 알아볼 수 없는 크기로 눌림).
            // 카드 폭이 이 값 밑으로 실제로 내려갈 일이 없는 안전한 하한선을 두어, 아직
            // 자리 잡지 못한 과도 상태의 측정값은 아예 반영하지 않는다.
            const MIN_SANE_WRAP_WIDTH = 100;
            function fitRoughmap(observedWidth) {
              const wrap = document.querySelector('.way-map-wrap');
              const widget = document.getElementById('daumRoughmapContainer1785386858595');
              if (!wrap || !widget) return;
              const NATIVE_W = 640;
              const NATIVE_H = 392; // 실측값(컨트롤 줄 포함 위젯 전체 높이) — 360이 아님
              const wrapWidth = observedWidth || wrap.getBoundingClientRect().width;
              if (!wrapWidth || wrapWidth < MIN_SANE_WRAP_WIDTH) return;
              // wrap.style.height를 여기서 바꾸는데, 그 wrap 자체를 ResizeObserver로 관찰하면
              // 높이 변경이 다시 resize를 유발해 무한 루프가 된다(실측으로 확인 — 화면이
              // 계속 흔들리고 렌더러가 버벅였음) — 폭이 실제로 달라졌을 때만 다시 계산한다.
              if (Math.abs(wrapWidth - roughmapLastWidth) < 1) return;
              roughmapLastWidth = wrapWidth;
              const scale = Math.min(1, wrapWidth / NATIVE_W);
              // 2026-08-23 — transform:scale은 위젯을 원래 크기(640px)로 그린 뒤 그 픽셀
              // 결과물을 통째로 시각적으로만 축소한다. 확대/축소/초기화 버튼의 아이콘이
              // 스프라이트 이미지의 background-position 좌표를 그대로 쓰는데, "-"나
              // 초기화(둥근 화살표)처럼 가는 선으로 된 아이콘은 이 사후 축소 과정에서
              // 서브픽셀 반올림에 씻겨나가 안 보이는 경우가 있었다(굵은 "+"는 살아남지만
              // 가는 선은 취약) — 실기로 확인됨. zoom은 축소된 최종 크기 기준으로 레이아웃
              // 자체를 다시 계산해 그리므로, 스프라이트도 처음부터 그 배율로 다시 그려져
              // 이 문제가 생기지 않는다. transform 대신 zoom을 쓴다.
              widget.style.transform = '';
              widget.style.zoom = String(scale);
              wrap.style.height = (NATIVE_H * scale) + 'px';
              // 2026-08-24 — zoom으로 바꾼 뒤에도 실기에서 "-"/초기화 아이콘이 여전히 흐리게
              // 보인다는 재확인이 있었다. zoom(비정수 배율, 예 0.839063)이 위젯 전체를 그
              // 배율로 다시 그리긴 하지만, 스프라이트 이미지가 정수 픽셀 경계에 안 맞게
              // 리샘플링되면서 가는 선 아이콘만 흐려지는 현상은 zoom에서도 남는다 — 확대/
              // 축소 버튼 묶음(.wrap_btn_zoom)만 별도로 correctZoomButtonIcons()에서 보정한다.
              correctZoomButtonIcons(scale);
            }
            // .wrap_btn_zoom(확대/축소/초기화 버튼 3개)만 부모(widget)의 zoom을 상쇄하는
            // 자기 zoom을 걸어 항상 배율 1(원본 픽셀)로 그리게 하고, 그 결과 커진 박스를
            // translate로 원래 있던 화면 위치로 되돌린다 — zoom은 조상→자손으로 곱해져
            // 적용되므로(자손 zoom을 1/scale로 주면 최종 배율이 정확히 1이 된다, 실측 확인:
            // .wrap_btn_zoom rect가 34×104 네이티브 크기로 돌아옴) 지도 자체는 계속 축소된
            // 채로, 이 버튼 묶음만 항상 정수 배율(1)로 그려져 스프라이트가 흐려지지 않는다.
            function correctZoomButtonIcons(scale) {
              const zw = document.querySelector('.wrap_btn_zoom');
              if (!zw) return;
              // 매 재계산마다 이전 보정을 먼저 지우고 다시 측정한다 — 안 그러면 이미 보정된
              // rect를 기준으로 또 보정을 얹어 위치가 호출할 때마다 계속 어긋난다.
              zw.style.zoom = '';
              zw.style.transform = '';
              const children = zw.children;
              const structureOk = children.length === 3 &&
                Array.prototype.every.call(children, (c) => /btn_zoom/.test(c.className));
              if (!structureOk) {
                // 카카오 쪽 마크업이 바뀌어 구조가 달라진 경우 — 조용히 원상태(보정 없음)로
                // 두고, 콘솔에만 남겨서 나중에 이 보정이 더 이상 안 맞다는 걸 알아챌 수 있게.
                if (zw.__iconFixWarned !== children.length) {
                  console.warn('[오시는 길 지도] 확대/축소 버튼 구조가 예상과 달라 아이콘 보정을 건너뜁니다:', children.length + '개', Array.prototype.map.call(children, (c) => c.className));
                  zw.__iconFixWarned = children.length;
                }
                return;
              }
              if (!(scale > 0) || scale >= 1) return; // 축소가 없으면 흐려질 것도 없다
              const before = zw.getBoundingClientRect();
              zw.style.zoom = String(1 / scale);
              const after = zw.getBoundingClientRect();
              const dx = before.right - after.right;
              const dy = before.top - after.top;
              zw.style.transform = `translate(${dx.toFixed(2)}px, ${dy.toFixed(2)}px)`;
            }
            // 위젯 내부 스크립트(document.write로 끼워진 카카오 자체 렌더)가 언제 끝날지
            // 확정할 수 없어 단발성 호출 하나로는 타이밍을 못 믿는다 — 여러 시점에 다시
            // 시도한다. 이미 정상 값을 잡았으면 위 가드가 즉시 no-op으로 반환하므로
            // 여러 번 불러도 안전하다.
            [300, 950, 1800, 3000].forEach((delay) => setTimeout(() => fitRoughmap(), delay));
            // window 'resize'만 쓰면 창 크기는 그대로인데 레이아웃만 바뀌는 경우(글자 크기
            // 조절 버튼 등)를 못 잡는다 — 컨테이너 크기 변화를 직접 관찰하는 ResizeObserver로.
            const roughmapWrap = document.querySelector('.way-map-wrap');
            if (typeof ResizeObserver !== 'undefined' && roughmapWrap) {
              new ResizeObserver((entries) => fitRoughmap(entries[0].contentRect.width)).observe(roughmapWrap);
            } else {
              window.addEventListener('resize', () => fitRoughmap());
            }
          </script>
        </div>
        <dl class="transit-card">
          <div class="transit-head"><h3>교통편 안내</h3></div>
          <div class="transit-row">
            <span class="transit-icon" aria-hidden="true">6</span>
            <div>
              <dt>지하철</dt>
              <dd>응암역 4번 출구 <span class="transit-sub">· 도보 약 16분</span></dd>
            </div>
          </div>
          <div class="transit-row">
            <span class="transit-icon transit-icon-bus" aria-hidden="true">🚌</span>
            <div>
              <dt>버스</dt>
              <div class="bus-list">
                {busStops.map((stop) => (
                  <div>
                    <dd>{stop.name} <span class="transit-sub">· 도보 {stop.walk}</span></dd>
                    <div class="bus-routes">
                      {stop.routes.map((bus) => <span>{bus}</span>)}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </dl>
      </div>
    </div>
  </section>

</BaseLayout>

