---
// 2026-08-17 디자인 목업 반영.
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { telHref } from '../lib/orgInfo';

const orgInfo = await getEntry('org-info', 'info');

// 활동 사진 — 확정 스키마 결정: 소식과 분리된 공유 gallery 컬렉션, "노출 위치"
// 체크박스로 페이지별 필터링(지금은 3곳 다 같은 사진이라 필터 결과도 동일).
const PHOTOS = (await getCollection('gallery'))
  .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))
  .filter((entry) => entry.data.showOn.includes('donate'))
  .map((entry) => ({ src: entry.data.photo, alt: entry.data.alt ?? '' }));
const galleryLoop = PHOTOS.concat(PHOTOS);
---

<BaseLayout pageName="후원 안내" bg="#E5EDED">
  <section aria-labelledby="dn-title" class="intro">
    <div class="wrap">
      <p class="eyebrow"><span class="pill">후원</span></p>
      <h1 id="dn-title">후원 안내</h1>
      <p class="lead-lg">여러분의 소중한 후원이 <br />상담과 교육, 낭독도서 제작 활동을 이어갑니다.</p>
    </div>
  </section>

  <section aria-labelledby="dn-letter">
    <div class="wrap letter-wrap">
      <div class="letter-card">
        <h2 id="dn-letter">함께 만드는 변화</h2>
        <p class="letter-copy">좋은비전은 시력이 달라진 순간을 처음 마주한 분들의 이야기를 듣고, 필요한 복지서비스와 교육·직업 정보로 연결합니다. 후원은 중도실명인 컨설팅, 심리평가와 상담, 청소년 진로상담, 낭독도서 제작을 지속하는 데 쓰입니다.</p>

        <div class="account-box">
          <h3 class="account-title">후원 계좌 안내</h3>
          <p class="account-number">{orgInfo.data.bankName} {orgInfo.data.accountNumber}</p>
          <p class="account-holder">예금주 {orgInfo.data.accountHolder}</p>
          <p class="account-note">정기 후원(CMS)을 원하시면 센터로 전화 주시기 바랍니다.</p>
          <p><a href={telHref(orgInfo.data.phone)} class="account-phone">( {orgInfo.data.phone} )</a></p>
        </div>

        <div class="receipt-box">
          <h3>기부금 영수증 신청 방법</h3>
          <ol>
            <li>입금 후 센터로 전화하거나 문자로 <strong>성명·생년월일·연락처</strong>를 알려주세요.</li>
            <li>기부금 영수증은 <strong>연말정산 기간 전</strong>에 국세청 자료로 등록됩니다.</li>
          </ol>
          <p class="receipt-contact">문의 <a href={telHref(orgInfo.data.phone)}>{orgInfo.data.phone}</a></p>
        </div>

        <p class="disclosure-note">연간 기부금 모금액과 활용실적은 <a href="/기부금-공시/">기부금 공시 내역</a>에서, 국세청 공시 자료는 <a href="https://www.nts.go.kr">국세청 홈페이지</a>에서 확인하실 수 있습니다.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="dn-gallery" class="band">
    <h2 id="dn-gallery" class="wrap">후원으로 이어진 활동</h2>
    <div class="marquee">
      <div class="marquee-track">
        {galleryLoop.map((photo, i) => (
          <img class="marquee-item" src={photo.src} alt={i >= PHOTOS.length ? '' : photo.alt} aria-hidden={i >= PHOTOS.length ? 'true' : undefined} loading="lazy" />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { background: #e5eded; padding: 66px 0 0; text-align: center; }
  .intro .wrap { max-width: 960px; }
  .pill { display: inline-flex; padding: 6px 14px; border-radius: 999px; background: #6c9a9c; color: #000; font: 700 0.94em/1.3 Pretendard, system-ui, sans-serif; }
  #dn-title { margin: 16px 0 0; font: 800 3.9em/1.25 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; letter-spacing: -0.03em; }
  .lead-lg { margin: 24px 0 0; font: 400 1.5em/1.7 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }

  .letter-wrap { max-width: 960px; padding: 44px 0 66px; }
  .letter-card { background: #fff; border: 3px solid #bdd2d2; border-radius: 20px; padding: 56px 52px; }
  #dn-letter { margin: 0 0 20px; font: 800 2.25em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; text-align: center; }
  .letter-copy { margin: 0 0 42px; font: 400 1.32em/1.95 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); text-align: center; text-wrap: pretty; }

  .account-box { border-top: 2px solid #bdd2d2; border-bottom: 2px solid #bdd2d2; padding: 46px 0; text-align: center; }
  .account-title { margin: 0 0 22px; font: 800 1.75em/1.3 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  .account-number { margin: 0 0 10px; font: 800 2.9em/1.3 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; letter-spacing: -0.02em; }
  .account-holder { margin: 0 0 28px; font: 700 1.5em/1.5 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }
  .account-note { margin: 0; font: 400 1.25em/1.8 NanumSquareRound, Pretendard, sans-serif; color: #5b534f; }
  .account-phone { font: 800 2.15em/1.5 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; text-decoration: none; }

  .receipt-box { margin-top: 46px; padding: 36px 34px; background: #f2f6f6; border: 2px solid #bdd2d2; border-radius: 16px; }
  .receipt-box h3 { margin: 0 0 18px; font: 800 1.88em/1.35 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  .receipt-box ol { margin: 0; padding-left: 1.4em; font: 400 1.32em/1.95 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }
  .receipt-box li { margin-bottom: 8px; }
  .receipt-contact { margin: 24px 0 0; font: 800 1.62em/1.5 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  .receipt-contact a { color: #332e1e; text-decoration: none; }

  .disclosure-note { margin: 38px 0 0; font: 400 1.06em/1.8 NanumSquareRound, Pretendard, sans-serif; color: #6b6550; text-align: center; text-wrap: pretty; }

  .band { background: #f2f6f6; border-top: 1px solid #bdd2d2; padding: 54px 0 62px; }
  #dn-gallery { margin: 0 0 22px; font: 800 1.7em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; }
  .marquee { overflow: hidden; }
  .marquee-track { display: flex; gap: 16px; width: max-content; animation: marquee 120s linear infinite; }
  .marquee:hover .marquee-track, .marquee:focus-within .marquee-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .marquee-item {
    width: 16.5em; height: 10.8em; flex: none; border-radius: 14px; background: #f2f6f6;
    object-fit: cover; display: block;
  }

  @media (max-width: 760px) {
    .letter-card { padding: 32px 24px; }
    #dn-title { font-size: 2.4em; }
    .account-number { font-size: 1.9em; }
  }
</style>
