---
// 2026-08-17 디자인 목업 반영 — 강의 안내.
// 2026-08-19 "강의 종류"·"기타 전문교육"을 CMS 폴더형 컬렉션으로 전환(작업지시서).
// 1페이지는 이 파일이 맡고, 각 섹션의 2페이지부터는 강의/종류/페이지/[page].astro·
// 강의/기타/페이지/[page].astro가 독립적으로 담당한다(소식/기부금-공시와 동일 패턴을
// 한 페이지 안의 두 개의 독립된 목록에 각각 적용 — 한쪽 페이지를 넘겨도 다른 쪽은
// 1페이지를 그대로 보여준다).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LectureGrid from '../../components/LectureGrid.astro';
import ExtraCourseGrid from '../../components/ExtraCourseGrid.astro';
import { sortForList as sortLectures, PAGE_SIZE as LECTURE_PAGE_SIZE, totalPages as lectureTotalPages } from '../../lib/lectures';
import { sortForList as sortExtraCourses, PAGE_SIZE as EXTRA_PAGE_SIZE, totalPages as extraTotalPages } from '../../lib/extraCourses';

// 확정 스키마 결정 — 강사 프로필은 폴더형(가변 개수), 강의 목록·강사 프로필 카드 그리드에
// 연결. 목업의 3명은 전부 "강사명 자리" placeholder였고 실제 강사 데이터가 아니었으므로
// 그대로 옮기지 않는다(가짜 이름을 진짜 데이터처럼 CMS에 넣는 게 더 나쁘다고 판단) —
// 대신 등록된 강사가 없을 때 그 사실을 알리는 안내문으로 대체한다.
const instructors = await getCollection('instructors');

const allLectures = sortLectures(await getCollection('lectures'));
const pageLectures = allLectures.slice(0, LECTURE_PAGE_SIZE);
const lecturePages = lectureTotalPages(allLectures.length);

const allExtraCourses = sortExtraCourses(await getCollection('extra-courses'));
const pageExtraCourses = allExtraCourses.slice(0, EXTRA_PAGE_SIZE);
const extraPages = extraTotalPages(allExtraCourses.length);
---

<BaseLayout pageName="강의 안내" bg="#F4E4E4">
  <section aria-labelledby="lc-title" class="intro">
    <div class="wrap">
      <p class="eyebrow"><span class="pill">강의 안내</span></p>
      <h1 id="lc-title">현장에서 바로 쓰이는 장애인식개선 교육</h1>
      <p class="lead-lg">한국장애인고용공단 직장 내 장애인 인식개선 교육 지정 수행기관이며, 한국장애인개발원 강사양성과정을 수료한 전문 강사진이 대상별 특성에 맞춰 교육을 진행합니다.</p>
      <a href="https://forms.gle/4vq94qaFYrEaPt758" class="btn btn-lg">
        강의 신청하기 <span class="sr-only">, Google Forms로 이동</span>
      </a>
    </div>
  </section>

  <section aria-labelledby="lc-kinds" class="tint">
    <div class="wrap">
      <h2 id="lc-kinds">강의 종류</h2>
      <p class="lecture-note">기관 요청에 따라 교육 시간과 세부 구성을 조정할 수 있습니다.</p>
      <LectureGrid lectures={pageLectures} currentPage={1} totalPages={lecturePages} />
    </div>
  </section>

  <section aria-labelledby="lc-extra" class="tint">
    <div class="wrap">
      <h2 id="lc-extra">기타 전문교육</h2>
      <p class="lead-sm">기관의 목적과 참여자의 특성에 따라 교육 내용을 협의하여 구성합니다.</p>
      <ExtraCourseGrid courses={pageExtraCourses} startIndex={0} currentPage={1} totalPages={extraPages} />
    </div>
  </section>

  <section aria-labelledby="lc-tutors" class="intro">
    <div class="wrap">
      <h2 id="lc-tutors">강사 프로필</h2>
      {instructors.length === 0 ? (
        <p class="lead-sm">아직 등록된 강사 프로필이 없습니다.</p>
      ) : (
        <ul class="tutor-grid">
          {instructors.map((t) => (
            <li class="tutor-card">
              <div class="tutor-profile">
                <img class="tutor-photo" src={t.data.photo} alt={t.data.photoAlt ?? ''} style={`object-position:${t.data.photoPos || 'center 20%'}`} />
                <div class="tutor-info">
                  <h3>{t.data.name}</h3>{' '}
                  <span class="tutor-role">{t.data.role}</span>{' '}
                  <ul class="tutor-bio" role="list" aria-label={`${t.data.name} 약력`}>
                    {t.data.bio.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .intro { background: #f4e4e4; padding: 62px 0 46px; }
  .tint { background: #faf2f2; padding: 58px 0; }
  .pill { display: inline-flex; padding: 6px 14px; border-radius: 999px; background: #c87a7a; color: #000; font: 700 0.94em/1.3 Pretendard, system-ui, sans-serif; }
  #lc-title { margin: 12px 0 0; font: 800 2.75em/1.4 Pretendard, system-ui, sans-serif; letter-spacing: -0.035em; color: #5a3737; max-width: 24em; text-wrap: pretty; }
  .lead-lg { margin: 22px 0 0; font: 400 1.32em/1.8 Pretendard, system-ui, sans-serif; color: var(--muted); max-width: 35em; text-wrap: pretty; }
  section[aria-labelledby='lc-title'] .btn { margin-top: 28px; font: 800 1.38em/1 Pretendard, system-ui, sans-serif !important; padding: 20px 36px; }

  #lc-extra, #lc-tutors { margin: 0 0 24px; font: 800 1.88em/1.4 Pretendard, system-ui, sans-serif; color: #5a3737; }
  #lc-kinds { margin: 0 0 10px; font: 800 1.88em/1.4 Pretendard, system-ui, sans-serif; color: #5a3737; }
  .lecture-note { margin: 0 0 32px; font: 400 0.92em/1.6 Pretendard, system-ui, sans-serif; color: #784949; }

  .lead-sm { margin: 0 0 24px; font: 400 1.06em/1.7 Pretendard, system-ui, sans-serif; color: var(--muted); }
  /* 2026-08-19 작업지시서 — 센터장·부센터장 프로필(기관소개.astro의 .leader-*)과 동일한
     가로형(사진 왼쪽·텍스트 오른쪽) 구조로 전환. 강사는 폴더형(가변 개수)이라 센터장의
     고정 2열 대신 2열 그리드로 자연스럽게 줄어들게 둔다 — 카드가 1장이면 한 칸만 차지하고
     나머지 칸은 비워둔다(기존 3열 세로형 카드에서도 같던 원칙 그대로 유지). */
  .tutor-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .tutor-card { border: 1px solid #e5bfbf; border-radius: 16px; background: #faf2f2; padding: 24px; }
  .tutor-profile { display: grid; grid-template-columns: minmax(150px, 190px) minmax(0, 1fr); gap: clamp(14px, 3vw, 18px); align-items: start; }
  /* leader-photo와 동일하게 세로 3:4 프레임으로 크롭(object-fit:cover) — photoPos(사진
     위치 조정)는 이 크롭 프레임 안에서 어느 부분을 보여줄지 정하는 값이라 의미가 그대로
     유지된다(기본값 'center 20%'도 leader-photo와 동일하게 그대로 둠). */
  .tutor-photo { width: 100%; max-width: 190px; aspect-ratio: 3/4; object-fit: cover; border-radius: 12px; display: block; }
  .tutor-info { min-width: 0; }
  .tutor-info h3 { margin: 0 0 6px; font: 800 1.38em/1.3 Pretendard, system-ui, sans-serif; color: #5a3737; }
  .tutor-role { display: block; font: 700 1em/1.4 Pretendard, system-ui, sans-serif; color: #784949; margin-bottom: 12px; }
  .tutor-bio { list-style: none; margin: 0; padding-left: 1.1em; display: grid; gap: 8px; }
  .tutor-bio li { position: relative; font: 400 1.06em/1.45 Pretendard, system-ui, sans-serif; color: var(--muted); text-wrap: pretty; }
  .tutor-bio li::before { content: ''; position: absolute; left: -1.1em; top: 0.62em; width: 5px; height: 5px; border-radius: 50%; background: #c87a7a; }

  @media (max-width: 860px) { .tutor-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 760px) {
    .tutor-profile { grid-template-columns: minmax(0, 1fr); }
    .tutor-photo { max-width: 200px; margin: 0 auto; }
  }
</style>
