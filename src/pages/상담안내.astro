---
// 2026-08-17 디자인 목업 반영 — 전문상담(URL은 /상담안내/ 유지, 표시 라벨만 "전문상담").
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { telHref } from '../lib/orgInfo';

const orgInfo = await getEntry('org-info', 'info');

const counselTopics = [
  { title: '중도실명인 재활 컨설팅', desc: '변화된 생활환경에 적응하고 새로운 삶을 준비하도록 복지서비스·교육·직업·여가·일상생활 적응 정보를 안내합니다.' },
  { title: '심리평가 및 상담', desc: '시각장애로 경험하는 심리적 어려움과 정서적 스트레스를 전문 심리평가에 근거해 상담합니다.' },
  { title: '청소년 진로 및 심리상담', desc: '통합학급·특수학급·특수학교 재학 중인 시각장애 청소년의 흥미와 강점, 적성, 진로를 함께 탐색합니다.' },
];

const counselFlow = [
  { step: 'STEP 1', title: '접수', desc: '전화 또는 신청서로 상담을 접수합니다.' },
  { step: 'STEP 2', title: '사전 확인', desc: '담당자가 연락해 상황과 희망 일정을 확인합니다.' },
  { step: 'STEP 3', title: '상담 진행', desc: '센터 방문 또는 전화로 상담하고, 필요 시 심리평가를 진행합니다.' },
  { step: 'STEP 4', title: '연결과 안내', desc: '필요한 서비스와 기관, 교육·직업 정보를 안내합니다.' },
];
---

<BaseLayout pageName="전문상담" bg="#F6DECF">
  <section aria-labelledby="cs-title" class="intro">
    <div class="wrap">
      <p class="eyebrow"><span class="pill">전문상담</span></p>
      <h1 id="cs-title">무엇부터 해야 할지 막막할 때, <br />먼저 이야기부터 나눕니다</h1>
      <p class="lead-lg">시각장애 당사자와 가족 모두 상담할 수 있습니다.<br />지금 상황을 함께 정리하고 필요한 복지서비스·교육·직업·일상생활 적응 정보를 안내합니다.</p>
    </div>
  </section>

  <section aria-labelledby="cs-call" class="tint">
    <div class="wrap call-grid">
      <div class="call-card">
        <h2 id="cs-call">전화로 상담하기</h2>
        <p class="call-hours">평일 09:00 – 18:00 (점심 12:00 – 13:00)</p>
        <a href={telHref(orgInfo.data.phone)} class="call-number">{orgInfo.data.phone}</a>
        <p class="call-note">번호를 누르면 바로 전화가 걸립니다.</p>
      </div>
      <div class="call-card call-card-form">
        <h2>신청서로 상담 접수하기</h2>
        <p>간단한 항목만 적어주시면 담당자가 연락드립니다.</p>
        <a href="#" class="btn btn-lg">상담 신청하기</a>
        <p class="call-note">신청서 주소 확인 후 연결합니다.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="cs-what" class="intro">
    <div class="wrap">
      <h2 id="cs-what">이런 상담을 제공합니다</h2>
      <ul class="topic-grid">
        {counselTopics.map((t) => (
          <li class="topic-card"><h3>{t.title}</h3>{' '}<span>{t.desc}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="cs-flow" class="tint">
    <div class="wrap">
      <h2 id="cs-flow">상담 진행 순서</h2>
      <ol class="flow-grid">
        {counselFlow.map((f) => (
          <li class="flow-card">
            <span class="flow-step">{f.step}</span>{' '}
            <span class="flow-title">{f.title}</span>{' '}
            <span class="flow-desc">{f.desc}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { background: #f6decf; padding: 62px 0 46px; }
  .tint { background: #faefe7; padding: 58px 0; }
  .pill { display: inline-flex; padding: 6px 14px; border-radius: 999px; background: #d97736; color: #000; font: 700 0.94em/1.3 Pretendard, system-ui, sans-serif; }
  #cs-title { margin: 12px 0 0; font: 800 2.75em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #623618; max-width: 24em; text-wrap: pretty; }
  .lead-lg { margin: 22px 0 0; font: 400 1.32em/1.8 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); max-width: 34em; text-wrap: pretty; }

  .call-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .call-card { padding: 38px 34px; border: 3px solid #edbe9f; border-radius: 18px; background: #faefe7; text-align: center; }
  .call-card h2 { margin: 0 0 12px; font: 800 1.62em/1.3 NanumSquareRound, Pretendard, sans-serif; color: #623618; }
  .call-hours { margin: 0 0 20px; font: 400 1.13em/1.6 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }
  .call-number { display: inline-block; font: 800 2.75em/1.1 NanumSquareRound, Pretendard, sans-serif; color: #332e1e; text-decoration: none; letter-spacing: -0.02em; }
  .call-note { margin: 16px 0 0; font: 400 1em/1.5 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }
  .call-card-form { display: flex; flex-direction: column; }
  .call-card-form p:first-of-type { margin: 0 0 24px; font: 400 1.13em/1.6 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }
  .call-card-form .btn { margin-top: auto; font: 800 1.5em/1 NanumSquareRound, Pretendard, sans-serif !important; padding: 22px 34px; }

  #cs-what, #cs-flow { margin: 0 0 24px; font: 800 1.88em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #623618; }
  .topic-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .topic-card { padding: 28px 26px; background: #fff; border: 1px solid #edbe9f; border-radius: 16px; }
  .topic-card h3 { margin: 0 0 10px; font: 800 1.32em/1.45 NanumSquareRound, Pretendard, sans-serif; color: #623618; text-wrap: pretty; }
  .topic-card span { display: block; font: 400 1.06em/1.75 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); text-wrap: pretty; }

  .flow-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .flow-card { padding: 26px 22px; border: 1px solid #edbe9f; border-radius: 16px; background: #faefe7; }
  .flow-step { display: block; font: 800 0.94em/1 NanumSquareRound, Pretendard, sans-serif; color: #824720; margin-bottom: 10px; }
  .flow-title { display: block; font: 800 1.25em/1.4 NanumSquareRound, Pretendard, sans-serif; color: #623618; margin-bottom: 8px; }
  .flow-desc { display: block; font: 400 1em/1.7 NanumSquareRound, Pretendard, sans-serif; color: var(--muted); }

  @media (max-width: 860px) { .topic-grid, .flow-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .call-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .topic-grid, .flow-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
