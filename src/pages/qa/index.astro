---
// 2026-08-18 Q&A 게시판 신설 — 작업지시서(홈 "처음 오신 분" 진입점 → Q&A 전체).
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 확정 스키마 결정 — section은 8개 값 고정, 순서도 지시서 원본 순서 그대로.
const SECTIONS = [
  { key: 'understanding-blindness', label: '시각장애의 이해' },
  { key: 'daily-life', label: '시각장애인 삶의 이해' },
  { key: 'etiquette', label: '시각장애인에 대한 에티켓' },
  { key: 'acceptance', label: '시각장애 수용의 이해' },
  { key: 'independent-living', label: '자립 및 자립생활의 이해' },
  { key: 'counseling', label: '상담의 이해' },
  { key: 'audiobook', label: '오디오도서의 이해' },
  { key: 'volunteer1365', label: '1365 자원봉사의 이해' },
];

const allQA = await getCollection('qa');

const sections = await Promise.all(
  SECTIONS.map(async (s) => {
    const items = allQA
      .filter((entry) => entry.data.section === s.key)
      .sort((a, b) => a.data.order - b.data.order);
    const rendered = await Promise.all(
      items.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
    );
    return { ...s, items: rendered };
  }),
);
---

<BaseLayout pageName="Q&A" bg="#F9F5EA">
  <section aria-labelledby="qa-title" class="intro">
    <div class="wrap">
      <p class="eyebrow"><span class="pill">상담 · Q&amp;A</span></p>
      <h1 id="qa-title">자주 묻는 질문</h1>
      <p class="lead-lg">시각장애와 시각장애인의 삶, 자립생활과 상담 등에 관한 자주 묻는 질문을 모았습니다.</p>
    </div>
  </section>

  <nav aria-label="Q&A 섹션 바로가기" class="qa-jumpnav">
    <div class="wrap">
      <ul class="qa-pills">
        {SECTIONS.map((s) => (
          <li><a href={`#${s.key}`} data-qa-pill data-target={s.key}>{s.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  {sections.map((s, i) => (
    <section aria-labelledby={s.key} class={i % 2 === 0 ? 'qa-section' : 'qa-section tint'}>
      <div class="wrap">
        <h2 id={s.key}>{s.label}</h2>
        <div class="qa-list">
          {s.items.map(({ entry, Content }) => (
            <details class="qa-item">
              <summary>{entry.data.question}</summary>
              <div class="qa-answer">
                <Content />
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<script>
  // 목업의 nav aria-current 패턴 재사용 — 뷰포트에 들어온 섹션의 pill에 aria-current를 켠다.
  const pills = Array.from(document.querySelectorAll('[data-qa-pill]'));
  const targets = pills
    .map((p) => document.getElementById(p.getAttribute('data-target') || ''))
    .filter((el) => el !== null);

  if (targets.length) {
    const setActive = (id) => {
      pills.forEach((p) => {
        if (p.getAttribute('data-target') === id) p.setAttribute('aria-current', 'true');
        else p.removeAttribute('aria-current');
      });
    };
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length) setActive(visible[0].target.id);
      },
      { rootMargin: '-15% 0px -75% 0px', threshold: 0 },
    );
    targets.forEach((t) => observer.observe(t));
    setActive(targets[0].id);
  }
</script>

<style>
  .intro { background: #f9f5ea; padding: 62px 0 46px; }
  .pill { display: inline-flex; padding: 6px 14px; border-radius: 999px; background: var(--green); color: #fff; font: 700 0.94em/1.3 Pretendard, system-ui, sans-serif; }
  #qa-title { margin: 12px 0 0; font: 800 2.5em/1.4 Pretendard, system-ui, sans-serif; letter-spacing: -0.03em; color: #332e1e; max-width: 24em; text-wrap: pretty; }
  .lead-lg { margin: 22px 0 0; font: 400 1.19em/1.75 Pretendard, system-ui, sans-serif; color: var(--muted); max-width: 36em; text-wrap: pretty; }

  /* 실제 ARIA 탭 위젯이 아니라 같은 페이지 안 앵커 점프 목록 — <nav>는 이동 가능한 링크
     묶음이라는 의미만 전달. 활성 표시는 주 메뉴 aria-current 패턴을 재사용하되, 섹션마다
     다른 색을 쓸 이유가 없어(주 메뉴는 페이지마다 강조색이 다르지만 이 페이지는 하나) 매번
     --tab-bg 커스텀 프로퍼티를 새로 만들지 않고 --green 하나로 고정한다. */
  .qa-jumpnav { background: #fff; border-bottom: 1px solid var(--line); padding: 18px 0; position: sticky; top: 0; z-index: 5; }
  .qa-pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .qa-pills a {
    display: inline-flex; align-items: center; min-height: 2.5rem; padding: 10px 16px;
    border-radius: 999px; background: #fff; border: 1.5px solid var(--line); color: var(--ink);
    text-decoration: none; font: 600 0.94em/1 Pretendard, system-ui, sans-serif;
  }
  .qa-pills a:hover { background: #f3eed9; }
  .qa-pills a[aria-current='true'] { background: var(--green); color: #fff; border-color: var(--green); font-weight: 800; }

  .qa-section { padding: 46px 0; }
  .qa-section.tint { background: #fbf8f0; }
  .qa-section h2 { margin: 0 0 22px; font: 800 1.62em/1.4 Pretendard, system-ui, sans-serif; color: #332e1e; scroll-margin-top: 145px; }

  .qa-list { display: grid; gap: 12px; }
  .qa-item { border: 1px solid var(--line); border-radius: 12px; background: #fff; padding: 4px 22px; }
  .qa-item summary {
    padding: 18px 4px; cursor: pointer; list-style: none;
    font: 700 1.13em/1.6 Pretendard, system-ui, sans-serif; color: var(--ink);
  }
  .qa-item summary::-webkit-details-marker { display: none; }
  .qa-item summary::before { content: '+'; display: inline-block; width: 1.2em; color: var(--green); font-weight: 800; }
  .qa-item[open] summary::before { content: '−'; }
  .qa-item[open] { border-color: var(--green); }
  .qa-answer { padding: 0 4px 22px 1.2em; font: 400 1.06em/1.85 Pretendard, system-ui, sans-serif; color: var(--muted); }
  .qa-answer :global(p) { margin: 0 0 14px; text-wrap: pretty; }
  .qa-answer :global(p:last-child) { margin-bottom: 0; }
  .qa-answer :global(ul), .qa-answer :global(ol) { margin: 0 0 14px; padding-left: 1.3em; display: grid; gap: 8px; }
  .qa-answer :global(blockquote) { margin: 10px 0; padding: 10px 16px; border-left: 3px solid var(--line); color: #6b6550; font-style: italic; }
  .qa-answer :global(table) { width: 100%; border-collapse: collapse; margin: 14px 0; }
  .qa-answer :global(th), .qa-answer :global(td) { border: 1px solid var(--line); padding: 10px 12px; text-align: left; font-size: 0.97em; }
  .qa-answer :global(th) { background: #f9f5ea; font-weight: 700; }

  @media (max-width: 640px) {
    .qa-jumpnav { position: static; }
  }
</style>
